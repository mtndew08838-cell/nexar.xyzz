local Cam = workspace.CurrentCamera

local function w2s(pos)
    local v, on = Cam:WorldToViewportPoint(pos)
    return Vector2.new(v.X, v.Y), on, v.Z
end

local function charBounds(char)
    local x0, y0, x1, y1 = math.huge, math.huge, -math.huge, -math.huge
    local hit = false
    for _, p in ipairs(char:GetDescendants()) do
        if p:IsA("BasePart") then
            local s = p.Size
            for _, cx in ipairs({-0.5, 0.5}) do
                for _, cy in ipairs({-0.5, 0.5}) do
                    for _, cz in ipairs({-0.5, 0.5}) do
                        local sc, on = w2s((p.CFrame * CFrame.new(s * Vector3.new(cx, cy, cz))).Position)
                        if on then
                            hit = true
                            x0 = math.min(x0, sc.X); x1 = math.max(x1, sc.X)
                            y0 = math.min(y0, sc.Y); y1 = math.max(y1, sc.Y)
                        end
                    end
                end
            end
        end
    end
    return hit and x0, y0, x1, y1
end

local function newDraw(kind, props)
    local d = Drawing.new(kind)
    for k, v in pairs(props) do d[k] = v end
    return d
end

local function buildObjects(player)
    local o = { BoxLines = {}, BoneLines = {}, ChamParts = {} }
    for _ = 1, 4 do
        table.insert(o.BoxLines, newDraw("Line", {
            Visible = false, Color = ESP.BoxColor,
            Thickness = 1.5, Transparency = 1,
        }))
    end
    for _ = 1, #BONES do
        table.insert(o.BoneLines, newDraw("Line", {
            Visible = false, Color = Color3.new(1,1,1),
            Thickness = 1, Transparency = 1,
        }))
    end
    local function txt(sz, col)
        return newDraw("Text", {
            Visible = false, Color = col, Size = sz,
            Center = true, Outline = true,
            OutlineColor = Color3.new(0,0,0), Font = 2,
        })
    end
    o.NameText   = txt(13, ESP.NameColor)
    o.DistText   = txt(11, ESP.DistColor)
    o.WeaponText = txt(11, ESP.WeaponColor)
    o.TracerLine = newDraw("Line", {
        Visible = false, Color = ESP.TracerColor,
        Thickness = 1, Transparency = 1,
    })
    o.HpBG   = newDraw("Line", { Visible = false, Color = Color3.new(0,0,0), Thickness = 4, Transparency = 1 })
    o.HpFill = newDraw("Line", { Visible = false, Color = ESP.HealthColor,  Thickness = 3, Transparency = 1 })
    ESP.Objects[player] = o
end

local function dropObjects(player)
    local o = ESP.Objects[player]; if not o then return end
    local function rm(d) if type(d)=="userdata" then pcall(function() d:Remove() end) end end
    for _, l in ipairs(o.BoxLines)  do rm(l) end
    for _, l in ipairs(o.BoneLines) do rm(l) end
    for k, v in pairs(o) do rm(v) end
    ESP.Objects[player] = nil
end

local function hideAll(o)
    for _, l in ipairs(o.BoxLines)  do l.Visible = false end
    for _, l in ipairs(o.BoneLines) do l.Visible = false end
    o.NameText.Visible   = false
    o.DistText.Visible   = false
    o.WeaponText.Visible = false
    o.TracerLine.Visible = false
    o.HpBG.Visible       = false
    o.HpFill.Visible     = false
end

-- chams: highlight all BaseParts with a SelectionBox or color override
local chamConnections = {}
local function applyCham(player)
    local char = player.Character
    if not char then return end
    local existing = chamConnections[player]
    if existing then
        for _, c in ipairs(existing) do pcall(function() c:Disconnect() end) end
    end
    chamConnections[player] = {}
    local function colorParts(c)
        for _, p in ipairs(c:GetDescendants()) do
            if p:IsA("BasePart") then
                p.Material = Enum.Material.Neon
                p.Color    = ESP.ChamColor
            end
        end
    end
    colorParts(char)
    table.insert(chamConnections[player],
        player.CharacterAdded:Connect(function(newChar)
            task.wait()
            if ESP.Chams then colorParts(newChar) end
        end)
    )
end

local function removeCham(player)
    local conns = chamConnections[player]
    if conns then
        for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
        chamConnections[player] = nil
    end
end

local function isPolice(player)
    -- checks team name or rank tag — adjust string to match the game
    local team = player.Team
    if team and (string.lower(team.Name):find("police") or string.lower(team.Name):find("cop") or string.lower(team.Name):find("nypd") or string.lower(team.Name):find("swat")) then
        return true
    end
    -- fallback: check a "Rank" attribute some RP games set
    local rank = player:GetAttribute("Rank") or player:GetAttribute("Job") or ""
    return string.lower(tostring(rank)):find("police") ~= nil
        or string.lower(tostring(rank)):find("officer") ~= nil
end

local vp = Cam.ViewportSize

local function runESP()
    vp = Cam.ViewportSize

    if not ESP.Enabled then
        for _, o in pairs(ESP.Objects) do hideAll(o) end
        return
    end

    local lp    = Players.LocalPlayer
    local lc    = lp.Character
    local lroot = lc and lc:FindFirstChild("HumanoidRootPart")
    local lhum  = lc and lc:FindFirstChildOfClass("Humanoid")

    for _, player in ipairs(Players:GetPlayers()) do
        if player == lp then continue end
        local o = ESP.Objects[player]
        if not o then continue end

        local char  = player.Character
        local root  = char and char:FindFirstChild("HumanoidRootPart")
        if not char or not root then hideAll(o); continue end

        if ESP.TeamCheck and player.Team == lp.Team then hideAll(o); continue end

        local dist = lroot and (root.Position - lroot.Position).Magnitude or 0
        if dist > ESP.MaxRange then hideAll(o); continue end

        local _, onScr = w2s(root.Position)
        if not onScr then hideAll(o); continue end

        local isPol     = isPolice(player)
        local drawColor = isPol and ESP.PoliceColor or ESP.BoxColor

        -- ── BOXES ───────────────────────────────────────────
        if ESP.Boxes then
            local bx0, by0, bx1, by1 = charBounds(char)
            if bx0 then
                local bl = o.BoxLines
                bl[1].From=Vector2.new(bx0,by0); bl[1].To=Vector2.new(bx1,by0)
                bl[2].From=Vector2.new(bx0,by1); bl[2].To=Vector2.new(bx1,by1)
                bl[3].From=Vector2.new(bx0,by0); bl[3].To=Vector2.new(bx0,by1)
                bl[4].From=Vector2.new(bx1,by0); bl[4].To=Vector2.new(bx1,by1)
                for _, l in ipairs(bl) do l.Color=drawColor; l.Visible=true end
            else
                for _, l in ipairs(o.BoxLines) do l.Visible=false end
            end
        else
            for _, l in ipairs(o.BoxLines) do l.Visible=false end
        end

        -- ── SKELETON ────────────────────────────────────────
        for i, pair in ipairs(BONES) do
            local p0 = char:FindFirstChild(pair[1])
            local p1 = char:FindFirstChild(pair[2])
            local bl = o.BoneLines[i]
            if ESP.Boxes and p0 and p1 then
                local s0,v0 = w2s(p0.Position)
                local s1,v1 = w2s(p1.Position)
                if v0 and v1 then
                    bl.From=s0; bl.To=s1; bl.Color=drawColor; bl.Visible=true
                else bl.Visible=false end
            else bl.Visible=false end
        end

        -- ── HEAD ANCHOR ─────────────────────────────────────
        local head   = char:FindFirstChild("Head")
        local hPos, hOn
        if head then hPos, hOn = w2s(head.Position + Vector3.new(0, 0.7, 0)) end

        local labelY = hPos and hPos.Y - 16 or 0
        local labelOffset = 0

        -- ── NAMES ───────────────────────────────────────────
        if ESP.Names and hPos and hOn then
            o.NameText.Position = Vector2.new(hPos.X, labelY - labelOffset)
            o.NameText.Text     = player.DisplayName
            o.NameText.Color    = isPol and ESP.PoliceColor or ESP.NameColor
            o.NameText.Visible  = true
            labelOffset         = labelOffset + 14
        else o.NameText.Visible = false end

        -- ── DISTANCE ────────────────────────────────────────
        if ESP.Distance and hPos and hOn then
            o.DistText.Position = Vector2.new(hPos.X, labelY - labelOffset)
            o.DistText.Text     = string.format("[%d studs]", math.floor(dist))
            o.DistText.Color    = ESP.DistColor
            o.DistText.Visible  = true
        else o.DistText.Visible = false end

        -- ── HEALTH BAR ──────────────────────────────────────
        if ESP.Health then
            local bx0, by0, bx1, by1 = charBounds(char)
            if bx0 then
                local hum  = char:FindFirstChildOfClass("Humanoid")
                local hp   = hum and hum.Health    or 100
                local mhp  = hum and hum.MaxHealth or 100
                local frac = math.clamp(hp / math.max(mhp, 1), 0, 1)
                local bx   = bx0 - 5
                o.HpBG.From   = Vector2.new(bx, by0)
                o.HpBG.To     = Vector2.new(bx, by1)
                o.HpBG.Visible = true
                o.HpFill.From  = Vector2.new(bx, by1)
                o.HpFill.To    = Vector2.new(bx, by1 - (by1 - by0) * frac)
                o.HpFill.Color = ESP.HealthColor
                o.HpFill.Visible = true
            else o.HpBG.Visible=false; o.HpFill.Visible=false end
        else o.HpBG.Visible=false; o.HpFill.Visible=false end

        -- ── WEAPON ──────────────────────────────────────────
        if ESP.Weapon then
            local tool = char:FindFirstChildOfClass("Tool")
            local bx0, by0, bx1, by1 = charBounds(char)
            if tool and by1 then
                local sc,_ = w2s(root.Position)
                o.WeaponText.Position = Vector2.new(sc.X, by1 + 4)
                o.WeaponText.Text     = tool.Name
                o.WeaponText.Color    = ESP.WeaponColor
                o.WeaponText.Visible  = true
            else o.WeaponText.Visible=false end
        else o.WeaponText.Visible=false end

        -- ── TRACERS ─────────────────────────────────────────
        if ESP.Tracers then
            local sc, vis = w2s(root.Position)
            if vis then
                o.TracerLine.From    = Vector2.new(vp.X / 2, vp.Y)
                o.TracerLine.To      = sc
                o.TracerLine.Color   = isPol and ESP.PoliceColor or ESP.TracerColor
                o.TracerLine.Visible = true
            else o.TracerLine.Visible=false end
        else o.TracerLine.Visible=false end

        -- ── CHAMS ───────────────────────────────────────────
        if ESP.Chams then
            applyCham(player)
        end
    end
end

