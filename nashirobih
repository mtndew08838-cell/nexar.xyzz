                LayoutOrder = index,
                Parent = results,
            })
            row:SetAttribute("NoDrag", true)
            corner(row)
            local rowStroke = stroke(row)
            hoverStroke(row, rowStroke)
            label({
                Position = UDim2.fromOffset(14, entry.Desc and 10 or 0),
                Size = UDim2.new(1, -130, 0, entry.Desc and 18 or height),
                Text = entry.Name,
                Parent = row,
            })
            if entry.Desc then
                label({
                    Position = UDim2.fromOffset(14, 30),
                    Size = UDim2.new(1, -130, 0, 17),
                    Text = entry.Desc,
                    TextSize = 13,
                    FontFace = Fonts.Regular,
                    TextColor3 = Theme.Muted,
                    Parent = row,
                })
            end
            local tag = create("Frame", {
                AnchorPoint = Vector2.new(1, 0.5),
                Position = UDim2.new(1, -12, 0.5, 0),
                Size = UDim2.fromOffset(0, 22),
                AutomaticSize = Enum.AutomaticSize.X,
                BackgroundColor3 = Theme.Surface,
                BorderSizePixel = 0,
