    local swatchBtn = create("TextButton", {
        AnchorPoint = Vector2.new(1, 0.5),
        Position    = UDim2.new(1, -24, 0.5, 0),
        Size        = UDim2.fromOffset(24, 15),
        BackgroundColor3 = defaultColor,
        BorderSizePixel  = 0,
        Text        = "",
        AutoButtonColor = false,
        ClipsDescendants = true,
        Parent      = row,
    })
