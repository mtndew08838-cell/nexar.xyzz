        if not overlay.Visible and box.Text == "" then
            return
        end
        overlay.Visible = false
        if box.Text ~= "" then
            box.Text = ""
        end
        box:ReleaseFocus()
    end
    self._closeSearch = closeSearch

    local function jumpTo(entry)
        closeSearch()
        if entry.Group and not entry.Group.Open then
            entry.Group:SetOpen(true)
        end
        self:SelectTab(entry.Tab)
        task.delay(0.4, function()
            local frame = entry.Frame
            if not frame.Parent or self._destroyed then
                return
            end
            local list = entry.Tab.List
            local offsetY = (frame.AbsolutePosition.Y - list.AbsolutePosition.Y) / self.Scale.Scale + list.CanvasPosition.Y - 8
            list.CanvasPosition = Vector2.new(0, math.max(offsetY, 0))
            flashStroke(entry.Group and entry.Group._stroke or frame:FindFirstChildOfClass("UIStroke"))
        end)
    end

    local function refresh()
        local query = string.lower((box.Text:gsub("^%s+", ""):gsub("%s+$", "")))
        for _, child in ipairs(results:GetChildren()) do
            if child:IsA("GuiObject") then
                child:Destroy()
            end
        end
        if query == "" then
            overlay.Visible = false
            emptyHolder.Visible = false
            return
        end

        local matches = {}
        local function consider(entry)
            if #matches < 40 and string.find(string.lower(entry.Name .. " " .. (entry.Desc or "")), query, 1, true) then
                table.insert(matches, entry)
            end
        end
        for _, tab in ipairs(self.Tabs) do
            if tab ~= self.Home then
                for _, entry in ipairs(tab._searchIndex or {}) do
                    if entry.Frame.Parent then
                        consider(entry)
                    end
                end
                local containers = { { tab.List, nil } }
                for _, group in ipairs(tab._groups or {}) do
                    table.insert(containers, { group.Body, group })
                end
                for _, pair in ipairs(containers) do
                    for _, frame in ipairs(pair[1]:GetChildren()) do
                        if frame:IsA("GuiObject") and not frame:GetAttribute("Indexed") then
                            local name, desc = elementTexts(frame)
                            if name then
                                consider({ Tab = tab, Frame = frame, Name = name, Desc = desc, Group = pair[2] })
                            end
                        end
                    end
                end
            end
        end

        overlay.Visible = true
        summary.Text = string.format("%d result%s for \"%s\"", #matches, #matches == 1 and "" or "s", box.Text)
        emptyHolder.Visible = #matches == 0
        emptyCaption.Text = "No elements match \"" .. box.Text .. "\""

        for index, entry in ipairs(matches) do
            local height = entry.Desc and 58 or 44
            local row = create("TextButton", {
                Size = UDim2.new(1, 0, 0, height),
                BackgroundColor3 = Theme.Surface2,
                BorderSizePixel = 0,
                Text = "",
                AutoButtonColor = false,
