    local function b64decode(data)
        local chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
        local lookup = {}
        for i = 1, #chars do lookup[chars:sub(i, i)] = i - 1 end
        local out, buf, bits = {}, 0, 0
        for i = 1, #data do
            local v = lookup[data:sub(i, i)]
            if v then
                buf  = buf * 64 + v
                bits = bits + 6
                if bits >= 8 then
                    bits = bits - 8
                    local byte = math.floor(buf / 2 ^ bits)
                    buf = buf % (2 ^ bits)
                    table.insert(out, string.char(byte))
                end
            end
        end
        return table.concat(out)
    end

    -- Writes the embedded PNG to disk and loads it as a custom asset.
    -- Falls back to a lucide icon if the executor has no file functions.
    function Library._loadDiscordIcon(img)
        local ok, asset = pcall(function()
            if type(writefile) ~= "function" or typeof(getcustomasset) ~= "function" then
                error("unsupported")
            end
            local folder = "AirFlowAssets"
            if type(isfolder) == "function" and type(makefolder) == "function" and not isfolder(folder) then
                makefolder(folder)
            end
            local path = folder .. "/discord.png"
            writefile(path, b64decode(DISCORD_PNG_B64))
            return getcustomasset(path)
        end)
        if ok and asset then
            img.Image = asset
        else
            applyIcon(img, "message-circle")
        end
    end
end

