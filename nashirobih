                if a >= 1 then break end
                RunService.Heartbeat:Wait()
            end
            SWEEP_SPEED = BASE_SPEED
        end)
    end)
    -- ══ End Community Stats Widget ═══════════════════════════════════════════

    tab._order = 10
    self.Home = tab
    return tab
