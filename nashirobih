-- Burst helpers: field names differ between gun kits, so they are discovered from the
-- equipped gun's own Setting table (any key containing "burst") instead of hardcoded.
local BurstLogged = setmetatable({}, { __mode = "k" })
local function ClassifyBurstKey(key, value)
    if type(key) ~= "string" then return nil end
    local k = key:lower()
    if not k:find("burst", 1, true) then return nil end
    if type(value) == "boolean" then return "enable" end
    if type(value) == "number" then
        if k:find("delay") or k:find("rate") or k:find("interval") or k:find("cooldown") or k:find("wait") or k:find("time") then
            return "delay"
        end
        return "count"
    end
    return nil
end

local function ApplyBurst(settings, enabled, count, delay)
    local found = {}
    for key, value in pairs(settings) do
        local kind = ClassifyBurstKey(key, value)
        if kind then found[#found + 1] = { key = key, kind = kind, old = value } end
    end
    if not BurstLogged[settings] then
        BurstLogged[settings] = true
        local names = {}
        for _, f in ipairs(found) do names[#names + 1] = ("%s(%s)=%s"):format(f.key, f.kind, tostring(f.old)) end
        print("[Burst] fields found in gun Setting:", #found == 0 and "NONE" or table.concat(names, ", "))
    end
    for _, f in ipairs(found) do
        pcall(function()
            if f.kind == "enable" then settings[f.key] = enabled
            elseif f.kind == "count" and count then settings[f.key] = count
            elseif f.kind == "delay" and delay then settings[f.key] = delay end
        end)
    end
    return #found
end

