    -- Odometer-style value: the old number rolls up and out, the new rolls in
    local function makeValue(cell, text)
        local slot = create("Frame", {
            Position               = UDim2.fromOffset(18, 36),
            Size                   = UDim2.new(1, -22, 0, 32),
            BackgroundTransparency = 1,
            ClipsDescendants       = true,
            ZIndex                 = 5,
            Parent                 = cell,
        })
        local function mk(t, y)
            return label({
                Position   = UDim2.fromOffset(0, y),
                Size       = UDim2.fromScale(1, 1),
                Text       = t,
                TextSize   = 24,
                FontFace   = Fonts.Bold,
                TextColor3 = C_WHITE,
                ZIndex     = 5,
                Parent     = slot,
            })
        end
        local current = mk(text, 0)
        local api = {}
        function api.Set(t)
            current.Text = t
        end
        function api.Roll(t)
            local old = current
            local new = mk(t, 30)
            new.TextTransparency = 1
            new.TextColor3 = C_ORANGE
            current = new
            tween(old, { Position = UDim2.fromOffset(0, -30), TextTransparency = 1 }, 0.35, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
            tween(new, { Position = UDim2.fromOffset(0, 0), TextTransparency = 0 }, 0.5, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
            task.delay(0.25, function()
                if new.Parent then
                    tween(new, { TextColor3 = C_WHITE }, 0.9, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
                end
            end)
            task.delay(0.5, function() old:Destroy() end)
        end
        return api
    end

    local ICON_POS = UDim2.fromOffset(25, 22)

