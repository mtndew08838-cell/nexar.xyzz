    -- ── Intro: cells slide in, numbers count up ───────────────────────────────

    local function countUp(api, getTarget, duration, gen)
        task.spawn(function()
            local t0 = os.clock()
            while true do
                if gen ~= introGen or not statsCard.Parent then return end
                local a = math.min((os.clock() - t0) / duration, 1)
                local e = 1 - (1 - a) ^ 4
                api.Set(fmtNum(math.floor(getTarget() * e + 0.5)))
                if a >= 1 then return end
                RunService.Heartbeat:Wait()
            end
        end)
    end

    local introCells = {
        { cell = memCell,  x = 0,   api = memVal,  target = function() return STAT_MEMBERS end },
        { cell = execCell, x = 0.5, api = execVal, target = function() return executions end },
    }

    local function playIntro()
        introGen = introGen + 1
        local gen = introGen
        counting = true
        for i, c in ipairs(introCells) do
            c.cell.GroupTransparency = 1
            c.cell.Position = UDim2.new(c.x, 0, 0, 10)
            c.api.Set("0")
            task.delay((i - 1) * 0.12, function()
                if gen ~= introGen then return end
                tween(c.cell, { GroupTransparency = 0, Position = UDim2.new(c.x, 0, 0, 0) }, 0.55, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
                countUp(c.api, c.target, 1.4, gen)
            end)
        end
        -- button fades in after the stats, ring included
        joinBtn.BackgroundTransparency = 1
        joinText.TextTransparency      = 1
        joinIcon.ImageTransparency     = 1
        joinRing.vis, joinRing.visTarget = 0, 0
        task.delay(0.4, function()
            if gen ~= introGen then return end
            joinRing.visTarget = 1
            tween(joinBtn,  { BackgroundTransparency = 0 }, 0.5)
            tween(joinText, { TextTransparency = 0 }, 0.5)
            tween(joinIcon, { ImageTransparency = 0 }, 0.5)
            joinScale.Scale = 0.93
            tween(joinScale, { Scale = 1 }, 0.55, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
            joinShine()
        end)
        task.delay(0.2, function()
            if gen == introGen then playShine() end
        end)
        task.delay(1.7, function()
            if gen == introGen then
