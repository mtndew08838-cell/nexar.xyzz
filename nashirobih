local ASSET_FOLDER = "NashiroAssets"
local assetCache = {}

local function b64decode(data)
    local chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
    local lookup = {}
    for i = 1, #chars do
        lookup[chars:sub(i, i)] = i - 1
    end
    local out, buf, bits = {}, 0, 0
    for i = 1, #data do
        local v = lookup[data:sub(i, i)]
        if v then
            buf = buf * 64 + v
            bits = bits + 6
            if bits >= 8 then
                bits = bits - 8
                local byte = math.floor(buf / 2 ^ bits)
                buf = buf % (2 ^ bits)
                table.insert(out, string.char(byte))
            end
        end
    end
    return table.concat(out)
end

local function customAsset(fileName, getBytes)
    if assetCache[fileName] then
        return assetCache[fileName]
    end
    if type(writefile) ~= "function" or typeof(getcustomasset) ~= "function" then
        return nil
    end
    local ok, asset = pcall(function()
        if type(isfolder) == "function" and type(makefolder) == "function" and not isfolder(ASSET_FOLDER) then
            makefolder(ASSET_FOLDER)
        end
        local path = ASSET_FOLDER .. "/" .. fileName
        if type(isfile) ~= "function" or not isfile(path) then
            writefile(path, getBytes())
        end
        return getcustomasset(path)
    end)
    if ok and type(asset) == "string" and asset ~= "" then
        assetCache[fileName] = asset
        return asset
    end
    return nil
end

local function urlFileName(url)
    local sum = 0
    for i = 1, #url do
        sum = (sum * 31 + url:byte(i)) % 1000000007
    end
    return "url_" .. sum .. ".png"
end

local LUCIDE_URL = "https://raw.githubusercontent.com/Footagesus/Icons/refs/heads/main/lucide/dist/Icons.lua"
local lucideSet = nil

local lucideLoading = false
local function loadLucide()
    if lucideSet ~= nil then
        return lucideSet
    end
    if lucideLoading then
        -- another thread is already downloading the icons: wait for it instead of downloading twice
        while lucideLoading do
            task.wait()
        end
        return lucideSet
    end
    lucideLoading = true
    local ok, result = pcall(function()
        local source = game:HttpGet(LUCIDE_URL)
        return loadstring(source)()
    end)
    if ok and type(result) == "table" then
        lucideSet = result
    else
        lucideSet = false
        warn("[AirFlow] lucide icons unavailable: " .. tostring(result))
    end
    lucideLoading = false
    return lucideSet
end

