end

local function safeDupeCycle(ToolName)
    local RS = game:GetService("ReplicatedStorage")
    local InventoryRemote = RS:FindFirstChild("Inventory")
    local BackpackRemote = RS:FindFirstChild("BackpackRemote")
    if not (InventoryRemote and BackpackRemote) then
        return false, "Remotes not found (Inventory / BackpackRemote)"
    end
    local safe = findDupeSafe()
    if not safe then return false, "Safe not found (HomeDoorSS.HomeDoor.Safe or 1# Map.2 Crosswalks.Safes)" end

    local before = countToolsNamed(ToolName)
    local ok, err = pcall(function()
        task.spawn(function() print("[SafeDupe] Store ->", pcall(BackpackRemote.InvokeServer, BackpackRemote, "Store", ToolName)) end)
        task.spawn(function() pcall(InventoryRemote.FireServer, InventoryRemote, "Change", ToolName, "Backpack", safe) end)
        task.wait(2)
        print("[SafeDupe] Grab ->", pcall(BackpackRemote.InvokeServer, BackpackRemote, "Grab", ToolName))
        task.wait(1)
    end)
    if not ok then return false, tostring(err) end
    local after = countToolsNamed(ToolName)
    print("[SafeDupe] items before:", before, "after:", after)
    if after < before + 1 then
        return false, ("Only %d x %s after the cycle (had %d), the dupe did not add a copy"):format(after, ToolName, before)
    end
    return true, ("%d x %s now (was %d)"):format(after, ToolName, before)
end

local function marketDupeOnce(ToolName)
    if MarketDupe.Busy then return false, "Already running" end
    MarketDupe.Busy = true
    local ok, res, msg = pcall(MarketDupe.Method == "Safe Dupe" and safeDupeCycle or marketDupeCycle, ToolName)
    MarketDupe.Busy = false
    if not ok then return false, tostring(res) end
    return res, msg
end

