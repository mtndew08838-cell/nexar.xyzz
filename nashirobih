    end
    local currentStatus = stepText(1)
    local function setStatus(text)
        currentStatus = text
        statusLabel.Position = UDim2.fromOffset(112, 72)
        statusLabel.TextTransparency = 1
        tween(statusLabel, { Position = UDim2.fromOffset(112, 66), TextTransparency = 0 }, 0.35, Enum.EasingStyle.Quint)
    end

    -- continuous motion: border comet, orbit rings, title shimmer, animated dots
    local started = os.clock()
    local animConnection = RunService.Heartbeat:Connect(function()
        if not loader.Parent then
            return
        end
        local t = os.clock() - started
        borderGrad.Rotation = (t * 170) % 360
        ringA.Rotation = (t * 260) % 360
        ringB.Rotation = (-(t * 150)) % 360
        titleGrad.Offset = Vector2.new(((t * 0.55) % 2) - 1, 0)
        local text = currentStatus .. string.rep(".", math.floor(t * 2.5) % 4)
        if statusLabel.Text ~= text then
            statusLabel.Text = text
        end
    end)

    -- from here on the UI build is split into short slices so this screen keeps animating.
    -- Nothing below this point may call create(), or it would count as build progress.
    local startCount = Library._createCount
    Library._slice = true
    Library._lastYield = os.clock()
    Library._lastCreate = os.clock()

    local shown = 0
    local lastStep = 1
    local finished = false
    local connection

    local function stopAnimations()
        alive = false
        flipping = false
        animConnection:Disconnect()
    end

    local function finish()
        finished = true
        Library._slice = false
        stopAnimations()
        if connection then
            connection:Disconnect()
        end
        pctLabel.Text = "100%"
        stepLabel.Text = "READY"
        tween(fill, { Size = UDim2.fromScale(1, 1) }, 0.2, Enum.EasingStyle.Quint)
        tween(headGlow, { Position = UDim2.fromScale(1, 0.5), ImageTransparency = 0.2 }, 0.2, Enum.EasingStyle.Quint)
        task.delay(0.25, function()
            sweep:Cancel()
            haloPulse:Cancel()
            headPulse:Cancel()
            tween(content, { GroupTransparency = 1 }, 0.2)
            tween(borderStroke, { Transparency = 1 }, 0.3)

            -- ring burst from the centre of the screen
            burst.Visible = true
            tween(burst, { Size = UDim2.fromOffset(560, 560) }, 0.7, Enum.EasingStyle.Quint)
            tween(burstStroke, { Transparency = 1, Thickness = 0.5 }, 0.7, Enum.EasingStyle.Quad)
            task.delay(0.75, function()
                burst:Destroy()
            end)

            local fit = self._fitScale or 1
            local target = self.Root.Size
            tween(loader, {
                Size = UDim2.fromOffset(target.X.Offset * fit, target.Y.Offset * fit),
                Position = UDim2.fromScale(0.5, 0.5),
            }, 0.5, Enum.EasingStyle.Quint)
            tween(loaderCorner, { CornerRadius = UDim.new(0, 10) }, 0.5, Enum.EasingStyle.Quint)
            tween(loaderScale, { Scale = 1 }, 0.5, Enum.EasingStyle.Quint)

            task.delay(0.28, function()
                self:_playIntro(true)
                tween(loader, { GroupTransparency = 1 }, 0.25)
                tween(loaderStroke, { Transparency = 1 }, 0.2)
                tween(loaderShadow, { ImageTransparency = 1 }, 0.2)
            end)
            task.delay(0.6, function()
                loader:Destroy()
            end)
        end)
    end

    -- real progress: icons downloaded + UI actually built. Nothing here is a fake timer.
    connection = RunService.Heartbeat:Connect(function(deltaTime)
        if finished then
            return
        end
        if self._destroyed or not loader.Parent then
            finished = true
            Library._slice = false
            stopAnimations()
            connection:Disconnect()
            return
        end
        local now = os.clock()
        local elapsed = now - started
        local iconsDone = lucideSet ~= nil
        local built = self._built == true
        local buildDone
        if waitForFinish then
            buildDone = built and (self._ready == true or elapsed > 45)
        else
            buildDone = built and (self._ready == true or now - Library._lastCreate > 0.5)
        end

        local iconPart = iconsDone and 1 or math.min(0.85, elapsed / 6)
        local made = Library._createCount - startCount
        local buildPart = buildDone and 1 or (made / (made + 1800)) * 0.95
        local target = 0.35 * iconPart + 0.65 * buildPart
        shown = math.max(shown, shown + (target - shown) * math.min(1, deltaTime * 6))
        local alpha = math.min(shown, 1)
        fill.Size = UDim2.fromScale(alpha, 1)
        headGlow.Position = UDim2.fromScale(alpha, 0.5)
        pctLabel.Text = string.format("%d%%", math.floor(alpha * 100 + 0.5))

        local step = (not iconsDone) and 1 or ((not buildDone) and 2 or 3)
        if step ~= lastStep then
            lastStep = step
            setStatus(stepText(step))
            stepLabel.Text = string.format("STEP %d / 3", step)
        end

        if iconsDone and buildDone and elapsed >= minTime and shown > 0.985 then
            finish()
        end
    end)
end

function Window:_fitToScreen(instant)
    local viewport = self.Gui.AbsoluteSize
    if viewport.X == 0 or viewport.Y == 0 then
        return
    end
    local size = self.Root.Size
    local scale = math.min(1, (viewport.X - 24) / math.max(size.X.Offset, 1), (viewport.Y - 24) / math.max(size.Y.Offset, 1))
    self._fitScale = math.max(scale, 0.45)
    if self._introDone and self.Open then
        if instant then
            self.Scale.Scale = self._fitScale
        else
            tween(self.Scale, { Scale = self._fitScale }, 0.2)
        end
    end
end

function Window:_clampToScreen()
    if not self.KeepOnScreen then
        return
    end
    local viewport = self.Gui.AbsoluteSize
    local root = self.Root
    local half = root.AbsoluteSize / 2
    local centre = root.AbsolutePosition + half - self.Gui.AbsolutePosition
    local clamped = Vector2.new(
        math.clamp(centre.X, math.min(half.X, viewport.X / 2), math.max(viewport.X - half.X, viewport.X / 2)),
        math.clamp(centre.Y, math.min(half.Y, viewport.Y / 2), math.max(viewport.Y - half.Y, viewport.Y / 2))
    )
    if (clamped - centre).Magnitude > 0.5 then
        tween(root, { Position = UDim2.fromOffset(clamped.X, clamped.Y) }, 0.25, Enum.EasingStyle.Quint)
    end
end

