    -- ══════════════════════════════════════════════════════════════════════════
    --  COMMUNITY STATS WIDGET  —  LayoutOrder 3 (between perf and server)
    --
    --  Border: faithful port of nazuro.lol's conic-gradient spinning border.
    --
    --  How the web version works (verbatim from their CSS):
    --    @property --angle { syntax:'<angle>'; initial-value:0deg }
    --    @keyframes spin-border { to { --angle: 360deg } }
    --    ::before {
    --      background: conic-gradient(from var(--angle),
    --        transparent 92%, #ff8c1e 96%, #fff 98%, #ff8c1e 100%);
    --      animation: spin-border 2s linear infinite;
    --      mask: content-box exclude, border-box;  ← punches hole so only border shows
    --    }
    --
    --  Roblox port:
    --    • Outer wrapper Frame (1px inset on each side) with UIStroke thickness 2
    --      and UICorner radius 8 — this IS the border ring.
    --    • A child Frame fills the wrapper, BackgroundTransparency=1, with a
    --      UIGradient whose Rotation spins on Heartbeat.
    --    • The UIGradient ColorSequence replicates the conic stops:
    --        0%   transparent  (92% of 360° = 331° of dark)
    --        92%  orange       (4° ramp up)
    --        96%  white        (2° hot peak)
    --        98%  orange       (2° ramp down)
    --        100% transparent  (loop back)
    --      The UIStroke Color is set to this gradient's color at the rotation
    --      angle — but Roblox UIStroke doesn't support gradients directly.
    --      Workaround: 8 thin Frame "ring slices" sized to cover each edge,
    --      each with its own UIGradient rotated to match its edge orientation,
    --      all driven by one shared rotation variable. This gives smooth color
    --      across all four sides simultaneously.
    --    • Outer ambient glow Frame pulses orange behind the card.
    --    • On exec tick: glow slams bright, counter pops with Back easing.
    -- ══════════════════════════════════════════════════════════════════════════

    local STAT_MEMBERS    = 1004
    local STAT_EXEC_START = 34034
    local STAT_EXEC_TICK  = 45

    local C_WHITE      = Color3.fromRGB(255, 255, 255)
    local C_ORANGE     = Color3.fromRGB(84, 208, 164)
    local C_TRANS_BG   = Theme.Surface2   -- blends with card bg when "off"
    local STAT_H       = 84               -- height of the stats row
    local BTN_Y        = 92               -- top of the Discord button
    local CARD_H_PX    = 138              -- total card height
    local DISCORD_INVITE = "https://discord.gg/qDgc5Sb5Xr"
    local BORDER_T     = 2                -- border thickness px

    -- ── Card ─────────────────────────────────────────────────────────────────
    local statsCard = create("Frame", {
        Size             = UDim2.new(1, 0, 0, CARD_H_PX),
        BackgroundColor3 = Theme.Surface2,
        BorderSizePixel  = 0,
        ClipsDescendants = false,
        LayoutOrder      = 3,
        Parent           = list,
    })
    statsCard:SetAttribute("NoDrag", true)
    corner(statsCard)

    -- ── Lightning border ─────────────────────────────────────────────────────
    --  Two UIStrokes driven by UIGradients (UIGradient works directly on a
    --  UIStroke), so the light follows the rounded outline perfectly with no
    --  seams at the corners:
    --    • ring  : thin, crisp stroke with two white-hot comets
    --    • bloom : wider, softer stroke with the same gradient (the glow)
    --  A random "strike" makes every ring flare and crackle together.
    --  makeRing() can be reused on any rounded element (the card, the button).

    -- Two comets: a bright one at 0.25 and a dimmer one at 0.75, each with a
    -- long fading tail behind a white-hot head.
    local function cometAlpha(floor)
        local function a(t) return floor + (1 - floor) * t end
        return NumberSequence.new({
            NumberSequenceKeypoint.new(0,    1),
            NumberSequenceKeypoint.new(0.04, 1),
            NumberSequenceKeypoint.new(0.16, a(0.7)),
            NumberSequenceKeypoint.new(0.23, a(0.15)),
            NumberSequenceKeypoint.new(0.25, a(0)),
            NumberSequenceKeypoint.new(0.265, a(0.35)),
            NumberSequenceKeypoint.new(0.3,  1),
            NumberSequenceKeypoint.new(0.54, 1),
            NumberSequenceKeypoint.new(0.66, a(0.85)),
            NumberSequenceKeypoint.new(0.73, a(0.45)),
            NumberSequenceKeypoint.new(0.75, a(0.3)),
            NumberSequenceKeypoint.new(0.765, a(0.6)),
            NumberSequenceKeypoint.new(0.8,  1),
            NumberSequenceKeypoint.new(1,    1),
        })
    end
    local COMET_COLOR = ColorSequence.new({
        ColorSequenceKeypoint.new(0,     C_ORANGE),
        ColorSequenceKeypoint.new(0.2,   C_ORANGE),
        ColorSequenceKeypoint.new(0.245, Color3.fromRGB(225, 255, 242)),
        ColorSequenceKeypoint.new(0.25,  C_WHITE),
        ColorSequenceKeypoint.new(0.265, C_ORANGE),
        ColorSequenceKeypoint.new(0.7,   C_ORANGE),
        ColorSequenceKeypoint.new(0.745, Color3.fromRGB(200, 248, 228)),
        ColorSequenceKeypoint.new(0.75,  C_WHITE),
        ColorSequenceKeypoint.new(0.765, C_ORANGE),
        ColorSequenceKeypoint.new(1,     C_ORANGE),
    })

    local rings = {}

    -- radius = corner radius of the host; scale = thickness multiplier;
    -- phase = degrees added to the sweep so rings don't move in lockstep.
    local function makeRing(host, radius, scale, phase)
        local function holder(z)
            local f = create("Frame", {
                AnchorPoint            = Vector2.new(0.5, 0.5),
                Position               = UDim2.fromScale(0.5, 0.5),
                Size                   = UDim2.new(1, -2, 1, -2),
                BackgroundTransparency = 1,
                BorderSizePixel        = 0,
                ZIndex                 = z,
                Parent                 = host,
            })
            create("UICorner", { CornerRadius = UDim.new(0, math.max(radius - 1, 0)), Parent = f })
            return f
        end
        local bloomStroke = create("UIStroke", {
            Color           = C_WHITE,
            Thickness       = 6 * scale,
            Transparency    = 0.5,
            ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
            Parent          = holder(1),
        })
        local bloomGrad = create("UIGradient", {
            Color = COMET_COLOR, Transparency = cometAlpha(0.45), Parent = bloomStroke,
        })
        local ringStroke = create("UIStroke", {
            Color           = C_WHITE,
            Thickness       = 2 * scale,
            Transparency    = 0,
            ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
            Parent          = holder(2),
        })
        local ringGrad = create("UIGradient", {
            Color = COMET_COLOR, Transparency = cometAlpha(0), Parent = ringStroke,
        })
        local entry = {
            ringStroke = ringStroke, ringGrad = ringGrad,
            bloomStroke = bloomStroke, bloomGrad = bloomGrad,
            scale = scale, phase = phase or 0,
            hover = 0, hoverTarget = 0,   -- 0..1 extra energy while hovered
            vis = 1, visTarget = 1,       -- 0..1 fade of the whole ring
        }
        table.insert(rings, entry)
        return entry
    end

    makeRing(statsCard, 8, 1, 0)

    -- Static base UIStroke so the card always has a visible dark border
    create("UIStroke", {
        Color            = Color3.fromRGB(42, 50, 68),
        Transparency     = 0,
        Thickness        = 1,
        ApplyStrokeMode  = Enum.ApplyStrokeMode.Border,
        Parent           = statsCard,
    })

    -- ── Animation state ──────────────────────────────────────────────────────
    local sweepAngle  = 0
    local BASE_SPEED  = 150     -- deg/sec
    local SWEEP_SPEED = BASE_SPEED
    local glowBurstT  = 0       -- set to 1 externally (exec tick)
    local strikeT     = 0       -- random lightning flare (also set by the button)
    local nextStrike  = os.clock() + 1.5

    local animConn
    animConn = RunService.Heartbeat:Connect(function(dt)
        if not statsCard.Parent then animConn:Disconnect() return end

        local now = os.clock()
        sweepAngle = (sweepAngle + dt * SWEEP_SPEED) % 360

        if now >= nextStrike then
            strikeT    = 1
            nextStrike = now + 1.6 + math.random() * 2.8
        end
        strikeT    = math.max(0, strikeT - dt * 4.5)
        glowBurstT = math.max(0, glowBurstT - dt * 1.8)

        local energy  = math.clamp(strikeT * 0.8 + glowBurstT, 0, 1)
        local flicker = math.noise(now * 16, 3.7)            -- ≈ -0.5 … 0.5
        local breathe = 0.5 + 0.5 * math.sin(now * math.pi * 2 / 2.4)
        local jitter  = strikeT > 0.05 and (math.random() - 0.5) * 0.05 * strikeT or 0

        for _, r in ipairs(rings) do
            r.hover = r.hover + (r.hoverTarget - r.hover) * math.min(1, dt * 10)
            r.vis   = r.vis   + (r.visTarget   - r.vis)   * math.min(1, dt * 4)
            local e = math.clamp(energy + r.hover * 0.55, 0, 1)

            local rot = (sweepAngle + r.phase) % 360
            r.ringGrad.Rotation  = rot
            r.bloomGrad.Rotation = rot
            r.ringGrad.Offset    = Vector2.new(jitter, 0)
            r.bloomGrad.Offset   = Vector2.new(jitter, 0)

            r.ringStroke.Thickness  = (1.6 + flicker * 0.5 + e * 1.4) * r.scale
            r.bloomStroke.Thickness = (4.5 + breathe * 1.5 + flicker * 1.2 + e * 5) * r.scale

            local bloomBase = math.clamp(0.55 - breathe * 0.08 - e * 0.35, 0, 1)
            r.ringStroke.Transparency  = 1 - r.vis
            r.bloomStroke.Transparency = 1 - (1 - bloomBase) * r.vis
        end
    end)

