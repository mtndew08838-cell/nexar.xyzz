    local ServerGroup = Misc:CreateGroup({ Name = "Server", Icon = "server", Side = "Left" })
    local InfoGroup = Misc:CreateGroup({ Name = "Server Info", Icon = "info", Side = "Right" })

    local busy = false

    local function notify(title, content, kind)
        pcall(function()
            Window:Notify({ Title = title, Content = content, Type = kind, Duration = 3 })
        end)
    end

    local function cooldown()
        task.delay(3, function()
            busy = false
        end)
    end

    local function hop(sortOrder, pickRandom)
        if busy then
            return
        end
        busy = true
        task.spawn(function()
            local url = string.format(
                "https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=%s&limit=100&excludeFullGames=true",
                game.PlaceId, sortOrder
            )
            local response
            pcall(function()
                response = HttpService:JSONDecode(game:HttpGet(url))
            end)
            local candidates = {}
            if type(response) == "table" and type(response.data) == "table" then
                for _, entry in ipairs(response.data) do
                    if entry.id ~= game.JobId and type(entry.playing) == "number" and entry.playing < (entry.maxPlayers or math.huge) then
                        table.insert(candidates, entry)
                    end
                end
            end
            if #candidates == 0 then
                notify("Server hop", "No other open server was found.", "Warning")
            else
                local target = pickRandom and candidates[math.random(#candidates)] or candidates[1]
                notify("Server hop", string.format("Joining a server with %d players.", target.playing), "Success")
                local ok, err = pcall(function()
                    MiscTeleport:TeleportToPlaceInstance(game.PlaceId, target.id, MiscPlayer)
                end)
                if not ok then
                    notify("Teleport failed", tostring(err), "Error")
                end
            end
            cooldown()
        end)
    end

    ServerGroup:CreateButton({
        Name = "Rejoin",
        Icon = "refresh-cw",
        Style = "Primary",
        Callback = function()
            if busy then
                return
            end
            busy = true
            notify("Rejoin", "Teleporting back into this server.", "Success")
            local ok, err = pcall(function()
                if game.JobId == "" or #MiscPlayers:GetPlayers() <= 1 then
                    MiscTeleport:Teleport(game.PlaceId, MiscPlayer)
                else
                    MiscTeleport:TeleportToPlaceInstance(game.PlaceId, game.JobId, MiscPlayer)
                end
            end)
            if not ok then
                notify("Teleport failed", tostring(err), "Error")
            end
            cooldown()
        end,
    })

