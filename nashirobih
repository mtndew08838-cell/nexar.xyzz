        Name = string.format("Place %d  |  Job %s", game.PlaceId, game.JobId == "" and "local" or game.JobId:sub(1, 8) .. ".."),
    })
end

-- ══════════════════════════════════════════════════════════════════════════
--  ME TAB (Main section)
--  Player Modifications ported from WereBetter.gg (The Bronx)
-- ══════════════════════════════════════════════════════════════════════════
do
    local MeReplicatedStorage = game:GetService("ReplicatedStorage")
    local MeWorkspace = game:GetService("Workspace")
    local MeStarterGui = game:GetService("StarterGui")
    local MePromptService = game:GetService("ProximityPromptService")

    -- unhooked FireServer, same trick WereBetter used for the respawn remote
    local rawFireServer = Instance.new("RemoteEvent").FireServer

    local previousCleanup = getgenv().__NashiroMeCleanup
    if previousCleanup then
        pcall(previousCleanup)
    end

    -- re-running the script must not stack a second set of connections
    local previous = getgenv().__NashiroMeConns
    if previous then
        for _, conn in ipairs(previous) do
            pcall(function()
                conn:Disconnect()
            end)
        end
    end
    local conns = {}
    getgenv().__NashiroMeConns = conns
    local function track(conn)
        conns[#conns + 1] = conn
        return conn
    end

    -- one switch per toggle (replaces Config.TheBronx.PlayerModifications)
    local Mods = {
        InfiniteSleep = false,
        InfiniteStamina = false,
        InfiniteHunger = false,
        InstantInteract = false,
        FastRespawn = false,
        RespawnWhereYouDied = false,
        AutoPickupBags = false,
        AutoPickupCash = false,
        BypassLockedCars = false,
        AntiLoseItems = false,
        DisableCameraBobbing = false,
        DisableBloodEffects = false,
        NoRentPay = false,
        NameTag = false,
        NoJumpCooldown = false,
        NoFallDamage = false,
    }

    local function setDisabled(script, value)
        if script and script.Disabled ~= value then
            script.Disabled = value
        end
    end

    -- ── Per-frame script switches + auto pickups ────────────────────────
    track(RunService.RenderStepped:Connect(function()
        local gui = LocalPlayer:FindFirstChild("PlayerGui")
        local char = LocalPlayer.Character

        if gui then
            local runGui = gui:FindFirstChild("Run")
            if runGui then
                setDisabled(runGui:FindFirstChild("StaminaBarScript", true), Mods.InfiniteStamina)
            end

            local hungerGui = gui:FindFirstChild("Hunger")
            if hungerGui then
                setDisabled(hungerGui:FindFirstChild("HungerBarScript", true), Mods.InfiniteHunger)
            end

            local sleepGui = gui:FindFirstChild("SleepGui")
            if sleepGui then
                setDisabled(sleepGui:FindFirstChild("sleepScript", true), Mods.InfiniteSleep)
            end

            local bloodGui = gui:FindFirstChild("BloodGui")
            if bloodGui and bloodGui.Enabled == Mods.DisableBloodEffects then
                bloodGui.Enabled = not Mods.DisableBloodEffects
            end

            local rentGui = gui:FindFirstChild("RentGui")
            if rentGui then
                setDisabled(rentGui:FindFirstChild("LocalScript"), Mods.NoRentPay)
            end
        end

        if char then
            setDisabled(char:FindFirstChild("CameraBobbing"), Mods.DisableCameraBobbing)
            setDisabled(char:FindFirstChild("FallDamageRagdoll"), Mods.NoFallDamage)
        end

        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if not hrp or typeof(fireproximityprompt) ~= "function" then
            return
        end

        if Mods.AutoPickupBags then
            local storage = MeWorkspace:FindFirstChild("Storage")
            if storage then
                for _, v in ipairs(storage:GetChildren()) do
                    if v:IsA("MeshPart") then
                        local owner = v:FindFirstChild("PlayerName")
                        local prompt = v:FindFirstChild("stealprompt")
                        if prompt
                            and (not owner or owner.Value ~= LocalPlayer.Name)
                            and (v.Position - hrp.Position).Magnitude < 5 then
                            fireproximityprompt(prompt)
                        end
                    end
                end
            end
        end

        if Mods.AutoPickupCash then
            local dollas = MeWorkspace:FindFirstChild("Dollas")
            if dollas then
                for _, v in ipairs(dollas:GetChildren()) do
                    if v:IsA("Part") then
                        local prompt = v:FindFirstChild("ProximityPrompt")
                        if prompt and (v.Position - hrp.Position).Magnitude < 5 then
                            fireproximityprompt(prompt)
                        end
                    end
                end
            end
        end
    end))

    -- ── Instant Interact + Bypass Locked Cars ───────────────────────────
    track(MePromptService.PromptButtonHoldBegan:Connect(function(prompt, who)
        if who ~= LocalPlayer then
            return
        end

        if Mods.InstantInteract then
            if typeof(fireproximityprompt) == "function" then
                fireproximityprompt(prompt)
            else
                local oldDuration = prompt.HoldDuration
                prompt.HoldDuration = 0
                task.wait()
                prompt.HoldDuration = oldDuration
            end
        end

        if Mods.BypassLockedCars then
            local char = LocalPlayer.Character
            local humanoid = char and char:FindFirstChild("Humanoid")
            local parent = prompt.Parent
            if humanoid and parent then
                local seat = parent:FindFirstChildWhichIsA("VehicleSeat")
                    or parent:FindFirstAncestorWhichIsA("VehicleSeat")
                    or (parent.Parent and parent.Parent:FindFirstChildWhichIsA("VehicleSeat"))
                if seat then
                    seat:Sit(humanoid)
                end
            end
        end
    end))

    -- ── Anti Jump Cooldown ──────────────────────────────────────────────
    track(UserInputService.JumpRequest:Connect(function()
        if not Mods.NoJumpCooldown then
            return
        end
        local char = LocalPlayer.Character
        local humanoid = char and char:FindFirstChildWhichIsA("Humanoid")
        if not humanoid then
            return
        end
        if humanoid.FloorMaterial == Enum.Material.Air then
            return
        end
        if humanoid.Jump or humanoid:GetState() == Enum.HumanoidStateType.Jumping then
            return
        end
        humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
    end))

    -- ── Keep Items On Death (list tools on the market, buy them back) ───
    local ExemptItems = { "Phone", "Fist", "Shiesty", "Bandage", "Lemonade", "Car keys", "Cuban", "GunPermit" }

    local function marketHasItem(toolName)
        local market = MeReplicatedStorage:FindFirstChild("MarketItems")
        if not market then
            return false
        end
        for _, item in ipairs(market:GetChildren()) do
            local owner = item:FindFirstChild("owner")
            if item.Name == toolName and owner and owner.Value == LocalPlayer.Name then
                return true
            end
        end
        return false
    end

    local function backpackHasItem(toolName)
        for _, tool in ipairs(LocalPlayer.Backpack:GetChildren()) do
            if tool:IsA("Tool") and tool.Name == toolName then
                return true
            end
        end
        return false
    end

    local function forcePutToMarket(toolName)
        local endTime = os.clock() + 12
        while os.clock() < endTime do
            if marketHasItem(toolName) then
                return true
            end
            pcall(function()
                MeReplicatedStorage.ListWeaponRemote:FireServer(toolName, 999999)
            end)
            task.wait(0.15)
        end
        return false
    end

    local function forceRetrieveFromMarket(toolName)
        local market = MeReplicatedStorage:WaitForChild("MarketItems", 10)
        if not market then
            return false
        end
        local endTime = os.clock() + 12
        while os.clock() < endTime do
            for _, item in ipairs(market:GetChildren()) do
                local owner = item:FindFirstChild("owner")
                local special = item:GetAttribute("SpecialId")
                if item.Name == toolName and owner and owner.Value == LocalPlayer.Name and special then
                    pcall(function()
                        MeReplicatedStorage.BuyItemRemote:FireServer(toolName, "Remove", special)
                    end)
                    task.wait(0.2)
                    pcall(function()
                        MeReplicatedStorage.BackpackRemote:InvokeServer("Grab", toolName)
                    end)
                    task.wait(0.2)
                    if backpackHasItem(toolName) then
                        return true
                    end
                end
            end
            task.wait(0.2)
        end
        return false
    end

    local function saveItemsOnDeath()
        if not Mods.AntiLoseItems then
            return
        end
        task.wait(0.25)
        local names = {}
        for _, tool in ipairs(LocalPlayer.Backpack:GetChildren()) do
            if tool:IsA("Tool") and not table.find(ExemptItems, tool.Name) then
                names[#names + 1] = tool.Name
            end
        end
        for _, name in ipairs(names) do
            forcePutToMarket(name)
        end
    end

    local function retrieveItemsAfterSpawn()
        task.delay(2.2, function()
            if not Mods.AntiLoseItems then
                return
            end
            local market = MeReplicatedStorage:FindFirstChild("MarketItems")
            if not market then
                return
            end
            local names = {}
            for _, item in ipairs(market:GetChildren()) do
                local owner = item:FindFirstChild("owner")
                if owner and owner.Value == LocalPlayer.Name then
                    names[#names + 1] = item.Name
                end
            end
            for _, name in ipairs(names) do
                forceRetrieveFromMarket(name)
            end
        end)
    end

    -- ── Character hooks: death position, fast respawn, items, name tag ──
    local DeathFrame = nil
    local trackedHumanoid = nil
    local lastRespawnFire = 0
    local RESPAWN_INTERVAL = 0.15

    local function hookCharacter(char)
        task.spawn(function()
            local humanoid = char:WaitForChild("Humanoid", 10)
            local hrp = char:WaitForChild("HumanoidRootPart", 10)
            if not humanoid or not hrp then
                return
            end
            trackedHumanoid = humanoid

            humanoid.Died:Connect(function()
                DeathFrame = hrp.CFrame
                saveItemsOnDeath()
            end)

            if Mods.RespawnWhereYouDied and typeof(DeathFrame) == "CFrame" then
                hrp.CFrame = DeathFrame
            end

            retrieveItemsAfterSpawn()
        end)
    end

    track(LocalPlayer.CharacterAdded:Connect(hookCharacter))
    if LocalPlayer.Character then
        hookCharacter(LocalPlayer.Character)
    end

    -- Faster Respawn
    track(RunService.PreRender:Connect(function()
        if not Mods.FastRespawn or not trackedHumanoid then
            return
        end
        if trackedHumanoid:GetState() ~= Enum.HumanoidStateType.Dead then
            lastRespawnFire = 0
            return
        end
        local now = os.clock()
        if now - lastRespawnFire < RESPAWN_INTERVAL then
            return
        end
        lastRespawnFire = now
        local remote = MeReplicatedStorage:FindFirstChild("LoadCharacter")
        if remote then
            rawFireServer(remote)
        end
        pcall(function()
            MeStarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, true)
        end)
    end))

    -- Name tag over the head (text and colors follow the Nashiro accent)
    local tagText, tagOutline = nil, nil
    local pulseTime = 0

    local function createNameTag(char)
        local head = char:WaitForChild("Head", 10)
        if not head then
            return
        end

        local billboard = Instance.new("BillboardGui")
        billboard.Name = "NashiroNameTag"
        billboard.Size = UDim2.new(0, 100, 0, 20)
        billboard.Adornee = head
        billboard.StudsOffset = Vector3.new(0, 1.3, 0)
        billboard.AlwaysOnTop = true
        billboard.Parent = head

        local outline = Instance.new("TextLabel")
        outline.Size = UDim2.fromScale(1, 1)
        outline.BackgroundTransparency = 1
        outline.TextScaled = true
        outline.Font = Enum.Font.GothamBold
        outline.Text = "Nashiro"
        outline.TextColor3 = Color3.new(0, 0, 0)
        outline.TextStrokeTransparency = 0
        outline.TextStrokeColor3 = Color3.new(0, 0, 0)
        outline.Parent = billboard

        local text = outline:Clone()
        text.TextStrokeTransparency = 1
        text.Parent = billboard

        tagText, tagOutline = text, outline
    end

    track(LocalPlayer.CharacterAdded:Connect(function(char)
        task.spawn(createNameTag, char)
    end))
    if LocalPlayer.Character then
        task.spawn(createNameTag, LocalPlayer.Character)
    end

    track(RunService.RenderStepped:Connect(function(dt)
        if not tagText or not tagOutline or not tagText.Parent then
            return
        end
        if not Mods.NameTag then
            tagText.Visible = false
            tagOutline.Visible = false
            return
        end
        pulseTime = pulseTime + dt * 1.2
        local pulse = (math.sin(pulseTime) + 1) / 2
        local base = Library.Theme.Accent
        local dark = base:Lerp(Color3.new(0, 0, 0), 0.45)
        tagText.TextColor3 = base:Lerp(dark, pulse * 0.25)
        tagText.Visible = true
        tagOutline.Visible = true
    end))

    -- ── UI ──────────────────────────────────────────────────────────────
    local Me = Window:CreateTab({ Name = "Me", Icon = "user", Category = "Main" })
    local PlayerMods = Me:CreateGroup({ Name = "Player Modifications", Icon = "user", Side = "Left" })

    local function addToggle(name, flag, key)
        PlayerMods:CreateToggle({
            Name = name,
            Default = false,
            Flag = "Me_" .. flag,
            Callback = function(value)
                Mods[key] = value == true
            end,
        })
    end

    addToggle("Infinite Sleep", "InfiniteSleep", "InfiniteSleep")
    addToggle("Infinite Stamina", "InfiniteStamina", "InfiniteStamina")
    addToggle("Infinite Hunger", "InfiniteHunger", "InfiniteHunger")
    addToggle("Instant Interact", "InstantInteract", "InstantInteract")
    addToggle("Faster Respawn", "FastRespawn", "FastRespawn")
    addToggle("Respawn Where U Died", "SpawnWhereDeath", "RespawnWhereYouDied")
    addToggle("Auto Loot Bags", "PickLoot", "AutoPickupBags")
    addToggle("Auto Pick Cash", "PickCash", "AutoPickupCash")
    addToggle("Bypass Locked Cars", "LockedCars", "BypassLockedCars")
    addToggle("Keep Items On Death", "AntiLoseItems", "AntiLoseItems")
    addToggle("Anti Camera Shake", "CameraBobbing", "DisableCameraBobbing")
    addToggle("Anti Blood Effects", "NoBloodEffects", "DisableBloodEffects")
    addToggle("Anti Rent Pay", "NoRentPay", "NoRentPay")
    addToggle("Nashiro Name Tag", "NameTag", "NameTag")
    addToggle("Anti Jump Cooldown", "NoJumpCooldown", "NoJumpCooldown")
    addToggle("Anti Fall Damage", "NoFallDamage", "NoFallDamage")

    -- ── Character Modifications (right column): Fly, Walk Speed, No Clip ─
    -- Ported from WereBetter.gg. Fly and Walk Speed rely on its "swim method":
    -- while either is on, the humanoid is held in FallingDown every frame.
    do
        local CharMods = Me:CreateGroup({ Name = "Character Modifications", Icon = "move", Side = "Right" })

        local function notify(title, content, kind)
            pcall(function()
                Window:Notify({ Title = title, Content = content, Type = kind, Duration = 3 })
            end)
        end

        local state = {
            fly = false,
            walk = false,
            noclip = false,
            flySpeed = 80,
            walkSpeed = 50,
        }

        track(RunService.Heartbeat:Connect(function()
            if not (state.fly or state.walk) then
                return
            end
            local char = LocalPlayer.Character
            local humanoid = char and char:FindFirstChildOfClass("Humanoid")
            if humanoid then
                humanoid:ChangeState(Enum.HumanoidStateType.FallingDown)
            end
        end))

        -- shared collision handling: Fly and No Clip both release collisions,
        -- and the original CanCollide values come back only when neither is on
        local savedCollide = setmetatable({}, { __mode = "k" })

        local function releaseCollision(char)
            for _, part in ipairs(char:GetDescendants()) do
                if part:IsA("BasePart") then
                    if savedCollide[part] == nil then
                        savedCollide[part] = part.CanCollide
                    end
                    part.CanCollide = false
                end
            end
        end

        local function restoreCollisionIfIdle(char)
            if not char or state.fly or state.noclip then
                return
            end
            for _, part in ipairs(char:GetDescendants()) do
                if part:IsA("BasePart") and savedCollide[part] ~= nil then
                    part.CanCollide = savedCollide[part]
                    savedCollide[part] = nil
                end
            end
        end

        -- ── Fly ─────────────────────────────────────────────────────────
        local fly = { conns = {}, velocity = nil, gyro = nil, seat = nil, anim = nil, token = 0 }
        local keys = { up = false, down = false }

        local function destroyFly()
            for _, conn in ipairs(fly.conns) do
                pcall(function()
                    conn:Disconnect()
                end)
            end
            fly.conns = {}
            if fly.velocity then
                fly.velocity:Destroy()
                fly.velocity = nil
            end
            if fly.gyro then
                fly.gyro:Destroy()
                fly.gyro = nil
            end
            if fly.seat then
                fly.seat:Destroy()
                fly.seat = nil
            end
            if fly.anim then
                pcall(function()
                    fly.anim:Stop()
                    fly.anim:Destroy()
                end)
                fly.anim = nil
            end
            keys.up = false
            keys.down = false
        end

        local function stopFly()
            fly.token = fly.token + 1
            local token = fly.token
            state.fly = false
            destroyFly()

            local char = LocalPlayer.Character
            if not char then
                return
            end
            restoreCollisionIfIdle(char)

            local humanoid = char:FindFirstChildWhichIsA("Humanoid")
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if not humanoid or not hrp then
                return
            end

            humanoid:ChangeState(Enum.HumanoidStateType.FallingDown)
            local deadline = os.clock() + 5
            while LocalPlayer:GetAttribute("LastACPos") and os.clock() < deadline do
                task.wait()
            end
            task.wait(0.1)
            if fly.token ~= token or not humanoid.Parent then
                return -- fly was switched on again, or the character is gone
            end
            humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
            hrp.AssemblyLinearVelocity = Vector3.zero
            hrp.AssemblyAngularVelocity = Vector3.zero
        end

        local function setupFly()
            destroyFly()
            fly.token = fly.token + 1

            local char = LocalPlayer.Character
            local humanoid = char and char:FindFirstChildWhichIsA("Humanoid")
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            if not humanoid or not hrp then
                return
            end

            state.fly = true
            releaseCollision(char)

            pcall(function()
                local anim = Instance.new("Animation")
                anim.AnimationId = "rbxassetid://70447345247039"
                local animator = humanoid:FindFirstChildOfClass("Animator") or humanoid
                fly.anim = animator:LoadAnimation(anim)
                fly.anim.Looped = true
                fly.anim:Play()
            end)

            local seat = Instance.new("VehicleSeat")
            seat.Name = "FlySeat"
            seat.Anchored = false
            seat.CanCollide = false
            seat.Transparency = 1
            seat.TopSurface = Enum.SurfaceType.Smooth
            seat.BottomSurface = Enum.SurfaceType.Smooth
            seat.Parent = MeWorkspace
            seat.CFrame = hrp.CFrame * CFrame.new(0, -3, 0)

            local weld = Instance.new("Weld")
            weld.Part0 = seat
            weld.Part1 = hrp
            weld.C0 = CFrame.new(0, 3, 0)
            weld.Parent = seat

            seat:Sit(humanoid)
            fly.seat = seat

            local velocity = Instance.new("BodyVelocity")
            velocity.MaxForce = Vector3.new(1e9, 1e9, 1e9)
            velocity.Velocity = Vector3.zero
            velocity.Parent = hrp
            fly.velocity = velocity

            local gyro = Instance.new("BodyGyro")
            gyro.MaxTorque = Vector3.new(1e9, 1e9, 1e9)
            gyro.P = 50000
            gyro.D = 1000
            gyro.CFrame = hrp.CFrame
            gyro.Parent = hrp
            fly.gyro = gyro

            table.insert(fly.conns, UserInputService.InputBegan:Connect(function(input, processed)
                if processed then
                    return
                end
                if input.KeyCode == Enum.KeyCode.Space then
                    keys.up = true
                elseif input.KeyCode == Enum.KeyCode.LeftShift then
                    keys.down = true
                end
            end))

            table.insert(fly.conns, UserInputService.InputEnded:Connect(function(input)
                if input.KeyCode == Enum.KeyCode.Space then
                    keys.up = false
                elseif input.KeyCode == Enum.KeyCode.LeftShift then
                    keys.down = false
                end
            end))

            table.insert(fly.conns, RunService.Stepped:Connect(function()
                if state.fly and char.Parent then
                    releaseCollision(char)
                end
            end))

            table.insert(fly.conns, RunService.RenderStepped:Connect(function()
                if not state.fly or not fly.velocity or not fly.gyro then
                    return
                end
                local cam = MeWorkspace.CurrentCamera
                if not cam then
                    return
                end

                local camCF = cam.CFrame
                local _, yRot, _ = camCF:ToOrientation()
                local uprightRot = CFrame.Angles(0, yRot, 0)
                local flatCamCF = CFrame.new(camCF.Position) * uprightRot
                local localInput = flatCamCF:VectorToObjectSpace(humanoid.MoveDirection)
                local worldMovement = camCF:VectorToWorldSpace(localInput)

                local speed = state.flySpeed
                local finalVelocity = worldMovement * speed
                if keys.up then
                    finalVelocity = finalVelocity + Vector3.new(0, speed, 0)
                end
                if keys.down then
                    finalVelocity = finalVelocity - Vector3.new(0, speed, 0)
                end
                if humanoid.Jump then
                    finalVelocity = finalVelocity + Vector3.new(0, speed, 0)
                end

                fly.velocity.Velocity = finalVelocity
                fly.gyro.CFrame = uprightRot
            end))
        end

        track(LocalPlayer.CharacterAdded:Connect(function(char)
            if not state.fly then
                return
            end
            char:WaitForChild("Humanoid", 10)
            char:WaitForChild("HumanoidRootPart", 10)
            task.wait(1.5)
            if state.fly then
                setupFly()
            end
        end))

        -- ── Walk Speed ──────────────────────────────────────────────────
        local walk = { conn = nil, freeze = nil, gyro = nil, anim = nil, token = 0 }
        local walkAnimation = Instance.new("Animation")
        walkAnimation.AnimationId = "rbxassetid://78828590676720"

        local function destroyWalk()
            if walk.conn then
                walk.conn:Disconnect()
                walk.conn = nil
            end
            if walk.freeze then
                walk.freeze:Disconnect()
                walk.freeze = nil
            end
            if walk.gyro then
                walk.gyro:Destroy()
                walk.gyro = nil
            end
            if walk.anim then
                pcall(function()
                    walk.anim:Stop()
                end)
                walk.anim = nil
            end
        end

        local function setupWalkMovement(humanoid, hrp)
            local gyro = Instance.new("BodyGyro")
            gyro.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
            gyro.P = 50000
            gyro.D = 1000
            gyro.Parent = hrp
            walk.gyro = gyro

            walk.conn = RunService.RenderStepped:Connect(function()
                if not state.walk then
                    return
                end
                local camera = MeWorkspace.CurrentCamera
                if not camera then
                    return
                end

                local look = camera.CFrame.LookVector
                local right = camera.CFrame.RightVector
                local flatLook = Vector3.new(look.X, 0, look.Z)
                local dir = Vector3.zero
                local usingKeys = false

                if not UserInputService:GetFocusedTextBox() then
                    if UserInputService:IsKeyDown(Enum.KeyCode.W) then
                        dir = dir + flatLook
                        usingKeys = true
                    end
                    if UserInputService:IsKeyDown(Enum.KeyCode.S) then
                        dir = dir - flatLook
                        usingKeys = true
                    end
                    if UserInputService:IsKeyDown(Enum.KeyCode.A) then
                        dir = dir - right
                        usingKeys = true
                    end
                    if UserInputService:IsKeyDown(Enum.KeyCode.D) then
                        dir = dir + right
                        usingKeys = true
                    end
                end

                if not usingKeys then
                    local md = humanoid.MoveDirection
                    dir = Vector3.new(md.X, 0, md.Z)
                end

                if dir.Magnitude > 0 then
                    dir = dir.Unit * state.walkSpeed
                end

                local groundedY = math.clamp(hrp.AssemblyLinearVelocity.Y, -100, -2)
                hrp.AssemblyLinearVelocity = Vector3.new(dir.X, groundedY, dir.Z)

                if dir.Magnitude > 0 then
                    gyro.CFrame = CFrame.new(hrp.Position, hrp.Position + Vector3.new(dir.X, 0, dir.Z))
                end

                hrp.AssemblyAngularVelocity = Vector3.zero

                if walk.anim then
                    if dir.Magnitude > 0 then
                        if not walk.anim.IsPlaying then
                            walk.anim:Play()
                        end
                    elseif walk.anim.IsPlaying then
                        walk.anim:Stop()
                    end
                end
            end)
        end

        local function beginWalk()
            destroyWalk()
            walk.token = walk.token + 1
            local token = walk.token

            local char = LocalPlayer.Character
            local humanoid = char and char:FindFirstChildOfClass("Humanoid")
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            if not humanoid or not hrp then
                return
            end

            hrp.AssemblyLinearVelocity = Vector3.zero
            walk.freeze = RunService.RenderStepped:Connect(function()
                if state.walk then
                    hrp.AssemblyLinearVelocity = Vector3.zero
                end
            end)

            notify("Walk Speed", "Bypassing movement, please wait...", "Warning")

            local animator = humanoid:FindFirstChildWhichIsA("Animator") or Instance.new("Animator", humanoid)
            walk.anim = animator:LoadAnimation(walkAnimation)
            walk.anim.Looped = true

            task.delay(1, function()
                if walk.token ~= token or not state.walk then
                    return
                end
                if walk.freeze then
                    walk.freeze:Disconnect()
                    walk.freeze = nil
                end
                setupWalkMovement(humanoid, hrp)
            end)
        end

        local function stopWalk()
            state.walk = false
            walk.token = walk.token + 1
            destroyWalk()
        end

        track(LocalPlayer.CharacterAdded:Connect(function()
            task.wait(1)
            if state.walk then
                beginWalk() -- WereBetter skipped this after respawn; refresh the references here
            end
        end))

        -- ── No Clip ─────────────────────────────────────────────────────
        local noclipConn = nil
        local noclipRay = RaycastParams.new()
        noclipRay.FilterType = Enum.RaycastFilterType.Exclude

        local function stopNoclip()
            state.noclip = false
            if noclipConn then
                noclipConn:Disconnect()
                noclipConn = nil
            end
            restoreCollisionIfIdle(LocalPlayer.Character)
        end

        local function startNoclip()
            state.noclip = true
            if noclipConn then
                noclipConn:Disconnect()
            end
            noclipConn = RunService.Stepped:Connect(function()
                local char = LocalPlayer.Character
                if not state.noclip or not char then
                    return
                end
                releaseCollision(char)

                local hrp = char:FindFirstChild("HumanoidRootPart")
                local humanoid = char:FindFirstChild("Humanoid")
                if not hrp or not humanoid then
                    return
                end

                local velocity = hrp.AssemblyLinearVelocity
                noclipRay.FilterDescendantsInstances = { char }
                local hit = MeWorkspace:Raycast(hrp.Position, Vector3.new(0, -20, 0), noclipRay)

                if hit then
                    if hit.Distance < 3 and velocity.Y < 0 then
                        hrp.AssemblyLinearVelocity = Vector3.new(velocity.X, 2, velocity.Z)
                    elseif hit.Distance < 10 and velocity.Y < -20 then
                        hrp.AssemblyLinearVelocity = Vector3.new(velocity.X, -10, velocity.Z)
                    end
                elseif hrp.Position.Y < -100 then
                    hrp.CFrame = CFrame.new(hrp.Position.X, 50, hrp.Position.Z)
                    hrp.AssemblyLinearVelocity = Vector3.zero
                    notify("No Clip", "Returned to a safe position", "Warning")
                end

                velocity = hrp.AssemblyLinearVelocity
                if velocity.Y < -50 then
                    hrp.AssemblyLinearVelocity = Vector3.new(velocity.X, -20, velocity.Z)
                end
            end)
        end

        -- re-executing the script tears this section down before building a new one
        getgenv().__NashiroMeCleanup = function()
            state.fly = false
            state.walk = false
            destroyFly()
            destroyWalk()
            stopNoclip()
            restoreCollisionIfIdle(LocalPlayer.Character)
        end

        -- ── UI ──────────────────────────────────────────────────────────
        CharMods:CreateToggle({
            Name = "Fly",
            Default = false,
            Flag = "Me_Fly",
            Callback = function(enabled)
                if enabled then
                    setupFly()
                    notify("Fly", "Enabled", "Success")
                else
                    task.spawn(stopFly)
                    notify("Fly", "Disabled")
                end
            end,
        })

        CharMods:CreateSlider({
            Name = "Fly Speed",
            Min = 0,
            Max = 300,
            Default = state.flySpeed,
            Flag = "Me_FlySpeed",
            Callback = function(value)
                state.flySpeed = value
            end,
        })

        CharMods:CreateToggle({
            Name = "Modify Walkspeed",
            Default = false,
            Flag = "Me_WalkSpeedToggle",
            Callback = function(enabled)
                if enabled then
                    if not state.walk then
                        state.walk = true
                        beginWalk()
                    end
                else
                    stopWalk()
                end
            end,
        })

        CharMods:CreateSlider({
            Name = "Walk Speed",
            Min = 1,
            Max = 400,
            Default = state.walkSpeed,
            Flag = "Me_WalkSpeed",
            Callback = function(value)
                state.walkSpeed = value
            end,
        })

        CharMods:CreateToggle({
            Name = "No Clip",
            Default = false,
            Flag = "Me_NoClip",
            Callback = function(enabled)
                if enabled then
                    startNoclip()
                    notify("No Clip", "Enabled", "Success")
                else
                    stopNoclip()
                    notify("No Clip", "Disabled")
                end
            end,
        })
    end
end

