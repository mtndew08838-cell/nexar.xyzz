-- Remote names come from the Valary script, NOT verified on the current game build.
local function marketDupeCycle(ToolName)
    local RS = game:GetService("ReplicatedStorage")
    local ListRemote = RS:FindFirstChild("ListWeaponRemote")
    local BackpackRemote = RS:FindFirstChild("BackpackRemote")
    local BuyRemote = RS:FindFirstChild("BuyItemRemote")
    local MarketItems = RS:FindFirstChild("MarketItems")
    if not (ListRemote and BackpackRemote and BuyRemote and MarketItems) then
        return false, "Market remotes not found (ListWeaponRemote / BackpackRemote / BuyItemRemote / MarketItems)"
    end

    local function countItems()
        local n = 0
        for _, holder in ipairs({ LocalPlayer:FindFirstChildOfClass("Backpack"), LocalPlayer.Character }) do
            if holder then
                for _, c in ipairs(holder:GetChildren()) do
                    if c:IsA("Tool") and c.Name == ToolName then n = n + 1 end
                end
            end
        end
        return n
    end
    local before = countItems()
    print("[MarketDupe] items before:", before, "ToolId will be captured from MarketItems")

    local ToolId
    local Connection = MarketItems.ChildAdded:Connect(function(item)
        if item.Name == ToolName then
            local owner = item:WaitForChild("owner", 5)
            if owner and owner.Value == LocalPlayer.Name then
                ToolId = item:GetAttribute("SpecialId")
            end
        end
    end)

    local ok, err = pcall(function()
        task.spawn(function() ListRemote:FireServer(ToolName, 99999) end)
        task.wait(0.26)
        task.spawn(function() print("[MarketDupe] Store ->", pcall(BackpackRemote.InvokeServer, BackpackRemote, "Store", ToolName)) end)
        task.wait(3)
        task.spawn(function() BuyRemote:FireServer(ToolName, "Remove", ToolId) end)
        task.spawn(function() print("[MarketDupe] Grab ->", pcall(BackpackRemote.InvokeServer, BackpackRemote, "Grab", ToolName)) end)
        task.wait(3)
    end)
    Connection:Disconnect()

    if not ok then return false, tostring(err) end
    if ToolId == nil then return false, "No SpecialId captured for the listing; dupe likely did not work" end
    task.wait(1)
    local after = countItems()
    print("[MarketDupe] items after:", after, "ToolId:", ToolId)
    if after < before + 1 then
        return false, ("Only %d x %s after the cycle (had %d), the dupe did not add a copy"):format(after, ToolName, before)
    end
    return true, ("%d x %s now (was %d)"):format(after, ToolName, before)
end

-- Names and paths below come from the WALSCRIPT source, NOT verified on the current build.
local function findDupeSafe()
    local ws = workspace
    local door = ws:FindFirstChild("HomeDoorSS")
    local homeDoor = door and door:FindFirstChild("HomeDoor")
    local safe = homeDoor and homeDoor:FindFirstChild("Safe")
    if safe then return safe end
    local map = ws:FindFirstChild("1# Map")
    local cross = map and map:FindFirstChild("2 Crosswalks")
    local safes = cross and cross:FindFirstChild("Safes")
    if safes then
        for _, v in ipairs(safes:GetChildren()) do
            if v:FindFirstChild("Union") or v:FindFirstChildWhichIsA("BasePart") then return v end
        end
    end
end

local function countToolsNamed(ToolName)
    local n = 0
    for _, holder in ipairs({ LocalPlayer:FindFirstChildOfClass("Backpack"), LocalPlayer.Character }) do
        if holder then
            for _, c in ipairs(holder:GetChildren()) do
                if c:IsA("Tool") and c.Name == ToolName then n = n + 1 end
            end
