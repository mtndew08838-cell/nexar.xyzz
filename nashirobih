            Text = name,
            TextSize = 12,
            FontFace = Fonts.Bold,
            TextColor3 = nameColor,
            TextTruncate = Enum.TextTruncate.None,
            LayoutOrder = 1,
            Parent = head,
        })
        if isLocal then
            table.insert(ownNameLabels, nameLabel)
        end
        if isDiscord then
            local tag = create("Frame", {
                Size = UDim2.fromOffset(0, 12),
                AutomaticSize = Enum.AutomaticSize.X,
                BackgroundColor3 = DISCORD_BLUE,
                BackgroundTransparency = 0.75,
                BorderSizePixel = 0,
                LayoutOrder = 2,
                Parent = head,
            })
            corner(tag, UDim.new(0, 4))
            padding(tag, 4, 4, 0, 0)
            label({
                Size = UDim2.fromOffset(0, 12),
                AutomaticSize = Enum.AutomaticSize.X,
                Text = "DISCORD",
                TextSize = 8,
                FontFace = Fonts.Bold,
                TextColor3 = Color3.fromRGB(160, 170, 255),
                TextTruncate = Enum.TextTruncate.None,
                Parent = tag,
            })
        end
        if (tonumber(msg.t) or 0) > 0 then
            label({
                Size = UDim2.fromOffset(0, 14),
                AutomaticSize = Enum.AutomaticSize.X,
                Text = os.date("%H:%M", math.floor(tonumber(msg.t))),
                TextSize = 10,
                FontFace = Fonts.Regular,
                TextColor3 = Theme.Muted,
                TextTruncate = Enum.TextTruncate.None,
                LayoutOrder = 3,
                Parent = head,
            })
        end

        local bubble = create("Frame", {
            Size = UDim2.fromOffset(0, 0),
            AutomaticSize = Enum.AutomaticSize.XY,
            BackgroundColor3 = isLocal and Theme.Accent:Lerp(Theme.Surface, 0.68) or Theme.Surface,
            BorderSizePixel = 0,
            LayoutOrder = 2,
            Parent = col,
        })
        corner(bubble, UDim.new(0, 10))
        local bubbleStroke = stroke(bubble, isLocal and Theme.Accent:Lerp(Theme.Surface, 0.45) or Theme.Stroke, 0)
        padding(bubble, 11, 11, 7, 8)
        local textLabel = label({
            Size = UDim2.fromOffset(0, 0),
            AutomaticSize = Enum.AutomaticSize.XY,
            Text = msg.c,
            TextSize = 13,
            FontFace = Fonts.Regular,
            TextColor3 = Theme.Text,
            TextWrapped = true,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextTruncate = Enum.TextTruncate.None,
            Parent = bubble,
        })
        local constraint = create("UISizeConstraint", {
            MaxSize = Vector2.new(maxTextW, math.huge),
            Parent = textLabel,
        })
        table.insert(constraints, constraint)

        rowCount = rowCount + 1
        refreshEmpty()

        if live then
            local scale = create("UIScale", { Scale = 0.85, Parent = bubble })
            bubble.BackgroundTransparency = 1
            bubbleStroke.Transparency = 1
            textLabel.TextTransparency = 1
            tween(scale, { Scale = 1 }, 0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
            tween(bubble, { BackgroundTransparency = 0 }, 0.25)
            tween(bubbleStroke, { Transparency = 0 }, 0.25)
            tween(textLabel, { TextTransparency = 0 }, 0.25)

            if isLocal or wasAtBottom then
                scrollToBottom(true)
            else
                jump.Visible = true
            end

            if not isLocal then
                if not isVisible then
                    unread = unread + 1
                    badgeText.Text = unread > 9 and "9+" or tostring(unread)
                    badge.Visible = true
                end
                if state.sound then
                    pcall(function() sound:Play() end)
                end
                if state.notify and not isVisible then
                    pcall(function()
                        self:Notify({ Title = name, Content = msg.c, Type = "Info", Duration = 3 })
                    end)
                end
            end
        end
        return row, bubbleStroke
    end

    -- ── networking ───────────────────────────────────────────────────────────
    local seen = {}
    local pendingEcho = {}
    local olderQueue = {}      -- already downloaded, not rendered yet (ascending)
    local initialLoaded = false
    local queryMode = true     -- false = server refused $key queries, fetch everything
    local hasMoreOlder = false
    local newestKey, oldestKey = nil, nil
    local failures = 0
    local loadingOlder = false

    local function parseMessages(body)
        if not body or body == "" or body == "null" then
            return {}, false
        end
        local ok, data = pcall(HttpService.JSONDecode, HttpService, body)
        if not ok or type(data) ~= "table" then
            return {}, false
        end
        if data.error ~= nil and data.a == nil then
            return {}, true
        end
        local list = {}
        for key, v in pairs(data) do
            if type(v) == "table" and type(v.a) == "string" and type(v.c) == "string" then
                table.insert(list, { key = key, a = v.a, c = v.c, t = tonumber(v.t) or 0 })
            end
        end
        table.sort(list, function(x, y)
            if x.t ~= y.t then
                return x.t < y.t
            end
            return x.key < y.key
        end)
        return list, false
    end

    local function noteKeys(list)
        for _, m in ipairs(list) do
            if not newestKey or m.key > newestKey then
                newestKey = m.key
            end
            if not oldestKey or m.key < oldestKey then
                oldestKey = m.key
            end
        end
    end

    local function renderIncoming(list)
        for _, m in ipairs(list) do
            seen[m.key] = true
            local echoKey = m.a .. "|" .. m.c .. "|" .. tostring(m.t)
            if m.a == LocalPlayer.Name and pendingEcho[echoKey] then
                pendingEcho[echoKey] = nil
            else
                addMessage(m, initialLoaded)
            end
        end
    end

    local function pollOnce()
        local url = messagesUrl
        if queryMode then
            if not initialLoaded then
                url = messagesUrl .. "?orderBy=%22%24key%22&limitToLast=" .. cfg.Initial
            elseif newestKey then
                url = messagesUrl .. "?orderBy=%22%24key%22&startAt=%22" .. newestKey .. "%22"
            end
        end
        local res = http({ Url = url, Method = "GET" })
        if not res or not res.Body then
            failures = failures + 1
            if failures >= 3 then
                setStatus("offline")
            end
            return
        end
        local list, refused = parseMessages(res.Body)
        if refused then
            if queryMode then
                queryMode = false -- fall back to downloading the whole feed
            else
                failures = failures + 1
                if failures >= 3 then
                    setStatus("offline")
                end
            end
            return
        end
        failures = 0
        if status ~= "ok" then
            setStatus("ok")
        end

        local fresh = {}
        for _, m in ipairs(list) do
            if not seen[m.key] then
                table.insert(fresh, m)
            end
        end
        noteKeys(list)

        if not initialLoaded then
            -- render the newest batch, keep the rest for scroll-up
            local start = math.max(1, #fresh - cfg.Initial + 1)
            for i = 1, start - 1 do
                seen[fresh[i].key] = true
                table.insert(olderQueue, fresh[i])
            end
            local batch = {}
            for i = start, #fresh do
                table.insert(batch, fresh[i])
            end
            if queryMode then
                hasMoreOlder = #fresh >= cfg.Initial
            end
            renderIncoming(batch)
            if #batch > 0 then
                oldestKey = batch[1].key
            end
            initialLoaded = true
            refreshEmpty()
            scrollToBottom(false)
            task.delay(0.4, function()
                scrollToBottom(false)
            end)
        elseif #fresh > 0 then
            renderIncoming(fresh)
        end
    end

    local function loadOlder()
        if loadingOlder or not initialLoaded then
            return
        end
        if #olderQueue == 0 and not (queryMode and hasMoreOlder and oldestKey) then
            return
        end
        loadingOlder = true
        task.spawn(function()
            local batch = {}
            if #olderQueue > 0 then
                local take = math.min(cfg.PageSize, #olderQueue)
                for i = #olderQueue - take + 1, #olderQueue do
                    table.insert(batch, olderQueue[i])
                end
                for _ = 1, take do
                    table.remove(olderQueue)
                end
            else
                local url = messagesUrl .. "?orderBy=%22%24key%22&endAt=%22" .. oldestKey .. "%22&limitToLast=" .. (cfg.PageSize + 1)
                local res = http({ Url = url, Method = "GET" })
                if res and res.Body then
                    local list = parseMessages(res.Body)
                    for _, m in ipairs(list) do
                        if not seen[m.key] then
                            seen[m.key] = true
                            table.insert(batch, m)
                        end
                    end
                    if #list < cfg.PageSize + 1 then
                        hasMoreOlder = false
                    end
                end
            end

            if #batch > 0 then
                local oldHeight = messages.AbsoluteCanvasSize.Y
                local oldY = messages.CanvasPosition.Y
                for _, m in ipairs(batch) do
                    addMessage(m, false)
                    if not oldestKey or m.key < oldestKey then
                        oldestKey = m.key
                    end
                end
                RunService.Heartbeat:Wait()
                RunService.Heartbeat:Wait()
                local diff = messages.AbsoluteCanvasSize.Y - oldHeight
                if diff > 0 then
                    messages.CanvasPosition = Vector2.new(0, oldY + diff)
                end
            end
            task.delay(0.3, function()
                loadingOlder = false
            end)
        end)
    end

    messages:GetPropertyChangedSignal("CanvasPosition"):Connect(function()
        if messages.CanvasPosition.Y <= 30 then
            loadOlder()
        end
        if jump.Visible and atBottom() then
            jump.Visible = false
        end
    end)

    local function sendWebhook(author, content)
        pcall(function()
            http({
                Url = cfg.Webhook,
                Method = "POST",
                Headers = JSON_HEADERS,
                Body = HttpService:JSONEncode({
                    username = author,
                    avatar_url = "https://www.roblox.com/avatar-thumbnail/image?userId=" .. tostring(LocalPlayer.UserId) .. "&width=420&height=420&format=png",
                    content = content,
                    allowed_mentions = { parse = {} },
                }),
            })
        end)
    end

    local lastSend = 0
    local sendCounter = 0
    local function send()
        local text = input.Text:match("^%s*(.-)%s*$")
        if not text or text == "" then
            return
        end
        if os.clock() - lastSend < cfg.Cooldown then
            -- too fast: nudge the input
            tween(inputStroke, { Color = Theme.Warning }, 0.1)
            task.delay(0.35, function()
                tween(inputStroke, { Color = input:IsFocused() and Theme.Accent or Theme.Stroke }, 0.25)
            end)
            return
        end
        lastSend = os.clock()
        input.Text = ""
        if fits(text) > cfg.MaxLength then
            text = string.sub(text, 1, (utf8.offset(text, cfg.MaxLength + 1) or (#text + 1)) - 1)
        end

        local t = os.time()
        sendCounter = sendCounter + 1
        local echoKey = LocalPlayer.Name .. "|" .. text .. "|" .. tostring(t)
        pendingEcho[echoKey] = true
        local _, bubbleStroke = addMessage({ key = "local_" .. sendCounter, a = LocalPlayer.Name, c = text, t = t }, true)

        task.spawn(function()
            local res = http({
                Url = messagesUrl,
                Method = "POST",
                Headers = JSON_HEADERS,
                Body = HttpService:JSONEncode({ a = LocalPlayer.Name, c = text, t = t }),
            })
            if not res or not res.Success then
                pendingEcho[echoKey] = nil
                if bubbleStroke and bubbleStroke.Parent then
                    tween(bubbleStroke, { Color = Theme.Error }, 0.2)
                end
                pcall(function()
                    self:Notify({ Title = "Chat", Content = "Message failed to send.", Type = "Error", Duration = 3 })
                end)
                return
            end
            sendWebhook(LocalPlayer.Name, text)
        end)
    end

    -- ── input behaviour ──────────────────────────────────────────────────────
    local function refreshInput()
        local text = input.Text
        local len = fits(text)
        if len > cfg.MaxLength then
            input.Text = string.sub(text, 1, (utf8.offset(text, cfg.MaxLength + 1) or (#text + 1)) - 1)
            return
        end
        counter.Text = len >= cfg.MaxLength * 0.7 and (len .. "/" .. cfg.MaxLength) or ""
        counter.TextColor3 = len >= cfg.MaxLength and Theme.Warning or Theme.Muted
        local hasText = text:match("%S") ~= nil
        tween(sendBtn, { BackgroundColor3 = hasText and Theme.Accent or Theme.Surface3 }, 0.18)
        tween(sendIcon, { ImageColor3 = hasText and Color3.new(1, 1, 1) or Theme.Muted }, 0.18)
    end
    input:GetPropertyChangedSignal("Text"):Connect(refreshInput)
    input.Focused:Connect(function()
        tween(inputStroke, { Color = Theme.Accent }, 0.18)
    end)
    input.FocusLost:Connect(function(enterPressed)
        tween(inputStroke, { Color = Theme.Stroke }, 0.18)
        if enterPressed then
            send()
            task.defer(function()
                input:CaptureFocus()
            end)
        end
    end)
    sendBtn.MouseButton1Click:Connect(function()
        send()
        tween(sendScale, { Scale = 0.88 }, 0.07)
        task.delay(0.07, function()
            tween(sendScale, { Scale = 1 }, 0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
        end)
    end)

    -- ── background loops ─────────────────────────────────────────────────────
    local function alive()
        return not self._destroyed and page.Parent ~= nil
    end

    -- visibility: clear unread + stick to the bottom whenever the tab opens
    task.spawn(function()
        local was = false
        while alive() do
            local vis = (self.Open and self.CurrentTab == tab) and true or false
            if vis and not was then
                unread = 0
                badge.Visible = false
                task.delay(0.35, function()
                    scrollToBottom(false)
                end)
            end
            was = vis
            isVisible = vis
            task.wait(0.2)
        end
        pcall(function() sound:Destroy() end)
    end)

    -- message polling (fast while the tab is open)
    task.spawn(function()
        while alive() do
            pcall(pollOnce)
            task.wait(isVisible and 1 or 3)
        end
    end)

    -- presence: who is online right now
    task.spawn(function()
        while alive() do
            task.wait(5)
            if not alive() then
                break
            end
            pcall(function()
                local res = http({
                    Url = cfg.Presence,
                    Method = "POST",
                    Headers = JSON_HEADERS,
                    Body = HttpService:JSONEncode({ username = LocalPlayer.Name }),
                })
                if res and res.Body then
                    local ok, data = pcall(HttpService.JSONDecode, HttpService, res.Body)
                    if ok and type(data) == "table" and data.activeCount then
                        online = math.max(1, tonumber(data.activeCount) or 1)
                        if status == "ok" then
                            pillText.Text = tostring(fixedOnline or online) .. " online"
                        end
                    end
                end
            end)
            pcall(function()
                local jobId = tostring(game.JobId)
                if jobId == "" then
                    jobId = "singleplayer"
                end
                http({
                    Url = base .. "/servers/" .. jobId .. "/" .. LocalPlayer.Name .. ".json",
                    Method = "PUT",
                    Headers = JSON_HEADERS,
                    Body = HttpService:JSONEncode({ name = LocalPlayer.Name, t = os.time() }),
                })
            end)
        end
    end)

    -- small public API
    tab.Chat = {
        Send = function(text)
            input.Text = text
            send()
        end,
        SetNameColor = selectSwatch,
    }
    return tab
end

Window.CreateChat = Window.Chat

function Window:_category(name)
    self._categories = self._categories or {}
    local info = self._categories[name]
    if info then
        return info
    end
    self._categoryCount = (self._categoryCount or 0) + 1
    info = { Name = name, Index = self._categoryCount, Count = 0, Tabs = {}, Collapsed = false }
    local header = create("TextButton", {
        Size = UDim2.new(1, 0, 0, 26),
        BackgroundTransparency = 1,
        Text = "",
        AutoButtonColor = false,
        LayoutOrder = info.Index * 1000,
        Parent = self.TabList,
    })
    if not self._introDone then
        header.Visible = false
    end
    label({
        Position = UDim2.fromOffset(6, 0),
        Size = UDim2.new(1, -30, 1, 0),
        Text = name,
        TextSize = 11,
        TextColor3 = Theme.Muted,
        Parent = header,
    })
    local chevron = create("ImageLabel", {
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -6, 0.5, 0),
        Size = UDim2.fromOffset(12, 12),
        BackgroundTransparency = 1,
        ImageColor3 = Theme.Muted,
        Parent = header,
    })
    applyIcon(chevron, "chevron-down")
    header.MouseButton1Click:Connect(function()
        info.Collapsed = not info.Collapsed
        tween(chevron, { Rotation = info.Collapsed and -90 or 0 }, 0.18)
        for _, button in ipairs(info.Tabs) do
            button.Visible = not info.Collapsed
        end
    end)
    info.Header = header
    self._categories[name] = info
    return info
end

local STRIP_Y, STRIP_H = 44, 32

-- horizontal tab pills shown at the top of every page (tabs of the same category)
function Window:_refreshStrips()
    for _, tab in ipairs(self.Tabs) do
        local strip = tab._strip
        if strip then
            for _, child in ipairs(strip:GetChildren()) do
                if child:IsA("TextButton") then
                    child:Destroy()
                end
            end
            local order = 0
            for _, other in ipairs(self.Tabs) do
                if other._group == tab._group then
                    order += 1
                    local selected = other == tab
                    local pill = create("TextButton", {
                        Size = UDim2.fromOffset(0, STRIP_H - 2),
                        AutomaticSize = Enum.AutomaticSize.X,
                        BackgroundColor3 = Theme.Surface3,
                        BackgroundTransparency = selected and 0 or 1,
                        Text = "",
                        AutoButtonColor = false,
                        LayoutOrder = order,
                        Parent = strip,
                    })
                    corner(pill, UDim.new(0, 8))
                    local pillStroke = stroke(pill, Theme.Stroke, selected and 0 or 1)
                    padding(pill, 14, 14, 0, 0)
                    local pillLabel = label({
                        Size = UDim2.fromOffset(0, STRIP_H - 2),
                        AutomaticSize = Enum.AutomaticSize.X,
                        Text = other.Name,
                        TextSize = 14,
                        TextColor3 = selected and Theme.Text or Theme.Muted,
                        TextTruncate = Enum.TextTruncate.None,
                        Parent = pill,
                    })
                    if not selected then
                        pill.MouseEnter:Connect(function()
                            tween(pill, { BackgroundTransparency = 0.5 }, 0.12)
                            tween(pillLabel, { TextColor3 = Theme.Text }, 0.12)
                        end)
                        pill.MouseLeave:Connect(function()
                            tween(pill, { BackgroundTransparency = 1 }, 0.2)
                            tween(pillLabel, { TextColor3 = Theme.Muted }, 0.2)
                        end)
                        pill.MouseButton1Click:Connect(function()
                            self:SelectTab(other)
                        end)
                    end
                end
            end
        end
    end
end

function Window:Tab(opts, icon)
    opts = normalize(opts, { Title = "Name", Description = "Desc" })
    if icon ~= nil and opts.Icon == nil then
        opts.Icon = icon
    end
    local tab = setmetatable({
        Name = opts.Name or "Tab",
        Window = self,
        _order = 0,
    }, Tab)

    local categoryInfo, order
    if opts.Category then
        categoryInfo = self:_category(opts.Category)
        categoryInfo.Count += 1
        order = categoryInfo.Index * 1000 + categoryInfo.Count
    else
        self._plainTabs = (self._plainTabs or 0) + 1
        order = self._plainTabs
    end
    tab._group = tab -- each page shows only its own tab pill

    local button = create("TextButton", {
        Size = UDim2.new(1, 0, 0, 32),
        BackgroundColor3 = Theme.Surface3,
        BackgroundTransparency = 1,
        Text = "",
        AutoButtonColor = false,
        LayoutOrder = order,
        Parent = self.TabList,
    })
    corner(button)
    local buttonStroke = stroke(button, Theme.Stroke, 1)
    tab._button = button
    if categoryInfo then
        table.insert(categoryInfo.Tabs, button)
        if categoryInfo.Collapsed then
            button.Visible = false
        end
    end

    local hasIcon = opts.Icon ~= nil
    if hasIcon then
        local iconImage = create("ImageLabel", {
            AnchorPoint = Vector2.new(0, 0.5),
            Position = UDim2.new(0, 12, 0.5, 0),
            Size = UDim2.fromOffset(16, 16),
            BackgroundTransparency = 1,
            ImageColor3 = Theme.Muted,
            ScaleType = Enum.ScaleType.Fit,
            Parent = button,
        })
        applyIcon(iconImage, opts.Icon)
        tab._icon = iconImage
    end
    tab._label = label({
        Position = UDim2.fromOffset(hasIcon and 36 or 14, 0),
        Size = UDim2.new(1, -(hasIcon and 44 or 22), 1, 0),
        Text = tab.Name,
        TextSize = 13,
        TextColor3 = Theme.Muted,
        Parent = button,
    })

    local page = create("Frame", {
        Name = tab.Name,
        Size = UDim2.fromScale(1, 1),
        BackgroundTransparency = 1,
        Visible = false,
        Parent = self.Content,
    })
    tab._page = page
    local strip = create("ScrollingFrame", {
        Name = "TabStrip",
        Position = UDim2.fromOffset(16, STRIP_Y),
        Size = UDim2.new(1, -32, 0, STRIP_H),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ScrollBarThickness = 0,
        ScrollingDirection = Enum.ScrollingDirection.X,
        AutomaticCanvasSize = Enum.AutomaticSize.X,
        CanvasSize = UDim2.new(),
        Parent = page,
    })
    strip:SetAttribute("NoDrag", true)
    create("UIListLayout", {
        FillDirection = Enum.FillDirection.Horizontal,
        VerticalAlignment = Enum.VerticalAlignment.Center,
        SortOrder = Enum.SortOrder.LayoutOrder,
        Padding = UDim.new(0, 6),
        Parent = strip,
    })
    tab._strip = strip
    if opts.Desc then
        label({
            Position = UDim2.fromOffset(20, STRIP_Y + STRIP_H + 6),
            Size = UDim2.new(1, -72, 0, 16),
            Text = opts.Desc,
            TextSize = 13,
            FontFace = Fonts.Regular,
            TextColor3 = Theme.Muted,
            Parent = page,
        })
    end
    local listTop = STRIP_Y + STRIP_H + (opts.Desc and 28 or 6)
    local list = create("ScrollingFrame", {
        Position = UDim2.fromOffset(0, listTop),
        Size = UDim2.new(1, 0, 1, -listTop),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ScrollBarThickness = 2,
        ScrollBarImageColor3 = Theme.Accent,
        ScrollBarImageTransparency = 0.5,
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        CanvasSize = UDim2.new(),
        Parent = page,
    })
    padding(list, 16, 16, 2, 16)
    create("UIListLayout", {
        SortOrder = Enum.SortOrder.LayoutOrder,
        Padding = UDim.new(0, 8),
        Parent = list,
    })
    tab.List = list

    local empty = emptyState(page, opts.Icon or "layout-grid", opts.EmptyText or "Nothing here yet")
    local elementCount = 0
    list.ChildAdded:Connect(function(child)
        if child:IsA("GuiObject") then
            elementCount += 1
            empty.Visible = false
        end
    end)
    list.ChildRemoved:Connect(function(child)
        if child:IsA("GuiObject") then
            elementCount = math.max(elementCount - 1, 0)
            empty.Visible = elementCount <= 0
        end
    end)
    empty.Visible = true

    button.MouseEnter:Connect(function()
        if self.CurrentTab ~= tab then
            tween(button, { BackgroundTransparency = 0.4 }, 0.12)
            tween(buttonStroke, { Transparency = 0.5 }, 0.12)
        end
    end)
    button.MouseLeave:Connect(function()
        if self.CurrentTab ~= tab then
            tween(button, { BackgroundTransparency = 1 }, 0.2)
            tween(buttonStroke, { Transparency = 1 }, 0.2)
        end
    end)
    button.MouseButton1Click:Connect(function()
        self:SelectTab(tab)
    end)
    tab._stroke = buttonStroke

    if not self._introDone then
        button.Visible = false
    end
    table.insert(self.Tabs, tab)
    self:_refreshStrips()
    if #self.Tabs == 1 then
        task.defer(function()
            self:SelectTab(tab)
        end)
    end
    return tab
end

