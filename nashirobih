    -- WereBetter "swim method" teleport: hold FallingDown until the server clears
    -- "LastACPos", move, then stand up. Bounded so it can never hang.
    local function flingTP(cf)
        local char = LocalPlayer.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if not hum or not hrp then return false end
        hum:ChangeState(Enum.HumanoidStateType.FallingDown)
        local deadline = os.clock() + 5
        while LocalPlayer:GetAttribute("LastACPos") and os.clock() < deadline do
            hum:ChangeState(Enum.HumanoidStateType.FallingDown)
            FlingRS.Heartbeat:Wait()
        end
        if not hrp.Parent then return false end
        hrp.CFrame = cf
        FlingRS.Heartbeat:Wait()
        hum:ChangeState(Enum.HumanoidStateType.GettingUp)
        return true
    end

    -- Closest unoccupied car in the folders WereBetter scans.
    local function findFreeCar(fromPos)
        local best, bestDist = nil, math.huge
        for _, folderName in ipairs({ "CivCars", "PoliceCars", "NPCCars", "Cars", "Vehicles" }) do
            local folder = workspace:FindFirstChild(folderName)
            if folder then
                for _, car in ipairs(folder:GetChildren()) do
                    if car:IsA("Model") then
                        local seat = car:FindFirstChild("DriveSeat") or car:FindFirstChildWhichIsA("VehicleSeat")
                        if seat and not seat.Occupant then
                            local part = car.PrimaryPart or car:FindFirstChildWhichIsA("BasePart")
                            if part then
                                local d = (part.Position - fromPos).Magnitude
                                if d < bestDist then
                                    bestDist = d
                                    best = car
                                end
                            end
                        end
                    end
                end
            end
        end
        return best
    end

    local function zeroCarVelocity(car)
        for _, p in ipairs(car:GetDescendants()) do
            if p:IsA("BasePart") then
                p.AssemblyLinearVelocity = Vector3.zero
                p.AssemblyAngularVelocity = Vector3.zero
            end
        end
    end

    -- Returns (ok, message).
    local function carFling(target)
        local tChar = target and target.Character
        local tHRP = tChar and tChar:FindFirstChild("HumanoidRootPart")
        if not tHRP then return false, "Target has no character" end
        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if not hrp or not hum then return false, "Your character is not ready" end

        local car = findFreeCar(hrp.Position)
        if not car then return false, "No free car found" end
        local seat = car:FindFirstChild("DriveSeat") or car:FindFirstChildWhichIsA("VehicleSeat")
        if not seat then return false, "Car has no seat" end

        local returnCF = hrp.CFrame
        local oldSize, oldTransp, oldCollide = tHRP.Size, tHRP.Transparency, tHRP.CanCollide
        local ok, msg = true, "Car fling done"

        -- Enlarged, invisible, non-colliding target root so the car connects easily (client-side only).
        pcall(function()
            tHRP.Size = Vector3.new(25, 25, 25)
            tHRP.Transparency = 1
            tHRP.CanCollide = false
        end)

        local runOk, runErr = pcall(function()
            flingTP(seat.CFrame)
            task.wait(0.1)
            seat:Sit(hum)
            car:SetAttribute("Usable", true)
            task.wait(1)
            if hum.SeatPart ~= seat then
                ok, msg = false, "Could not sit in the car"
                return
            end

            -- Leave the seat while keeping network ownership of the car.
            local t0 = os.clock()
            while os.clock() - t0 < 1.5 do
                pcall(function()
                    hum.Sit = false
                    hum.Jump = true
                    hum:ChangeState(Enum.HumanoidStateType.Jumping)
                    if hum.SeatPart then hum.SeatPart = nil end
                    if seat.Occupant then seat.Occupant = nil end
                    for _, w in ipairs(seat:GetDescendants()) do
                        if w:IsA("Weld") or w:IsA("Motor6D") or w.Name == "SeatWeld" then
                            w:Destroy()
                        end
                    end
                end)
                if not hum.Sit and not hum.SeatPart and not seat.Occupant then break end
                task.wait(0.02)
            end

            -- Hold FallingDown for 1s, then put yourself back where you started.
            local holding = true
            task.spawn(function()
                while holding do
                    pcall(function() hum:ChangeState(Enum.HumanoidStateType.FallingDown) end)
                    task.wait()
                end
            end)
            task.wait(1)
            holding = false
            local myHRP = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            if myHRP then
                myHRP.AssemblyLinearVelocity = Vector3.zero
                myHRP.AssemblyAngularVelocity = Vector3.zero
                myHRP.CFrame = returnCF
            end

            -- Drive the car through the target and launch it upward.
            local t1 = os.clock()
            while os.clock() - t1 < 3.5 do
                if not car.Parent or not tHRP.Parent then break end
                pcall(function() car:PivotTo(CFrame.new(tHRP.Position)) end)
                for _, p in ipairs(car:GetDescendants()) do
                    if p:IsA("BasePart") then
                        p.AssemblyLinearVelocity = Vector3.new(0, 10500, 0)
                        p.AssemblyAngularVelocity = Vector3.zero
                    end
                end
                task.wait(0.02)
            end
            pcall(zeroCarVelocity, car)
        end)
        if not runOk then
            ok, msg = false, tostring(runErr)
        end

        -- One cleanup path: restore target root, stand up, go back.
        pcall(function()
            tHRP.Size = oldSize
            tHRP.Transparency = oldTransp
            tHRP.CanCollide = oldCollide
        end)
        pcall(function()
            hum.Sit = false
            task.wait()
            hum:ChangeState(Enum.HumanoidStateType.Jumping)
        end)
        task.wait(0.2)
        pcall(flingTP, returnCF)
        return ok, msg
    end

