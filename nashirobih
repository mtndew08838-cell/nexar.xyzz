-- ═══════════════════════════════════════════════════════════
--  Config multi-tab inside the Settings tab
--  Pills: Settings | Local Configs | Publish Public Config | Public Configs
--  Local configs use Window:SaveConfig / LoadConfig / DeleteConfig / ListConfigs,
--  so they share the folder and file format of the existing ConfigManager.
--  Publish / Public need a server: set Window.PublicConfigBackend = {
--      list     = function(query)                  -> { { name=, author=, updatedAt=(unix) }, ... },
--      download = function(entry)                  -> flags table (same shape SaveConfig writes),
--      publish  = function(name, description, flags) -> ok, err,
--  }   until then those two pills show "not configured".
-- ═══════════════════════════════════════════════════════════
do
    local okConfig, errConfig = pcall(function()
        -- the Settings tab keeps its normal elements under the first pill and gets
        -- the config pages under the other three, so its default strip is replaced
        local ConfigTab = Settings
        local page = ConfigTab._page
        ConfigTab._strip.Visible = false

        -- ── helpers ───────────────────────────────────────────
        local function notify(title, content, kind)
            pcall(function()
                Window:Notify({ Title = title, Content = content, Type = kind, Duration = 3 })
            end)
        end

        local function backend()
            return Window.PublicConfigBackend
        end

        local function fsReady()
            return type(writefile) == "function" and type(readfile) == "function" and type(isfile) == "function"
        end

        local function metaPath(name)
            return Window.ConfigFolder .. "/" .. name .. ".meta"
        end

        local lastStamp = {}
        local function touchStamp(name)
            if not fsReady() or type(name) ~= "string" then
                return
            end
            local now = os.time()
            if lastStamp[name] and now - lastStamp[name] < 5 then
                return
            end
            lastStamp[name] = now
            pcall(writefile, metaPath(name), tostring(now))
        end

        local function readStamp(name)
            if not fsReady() then
                return nil
            end
            local okE, exists = pcall(isfile, metaPath(name))
            if not okE or not exists then
                return nil
            end
            local okR, raw = pcall(readfile, metaPath(name))
            return okR and tonumber(raw) or nil
        end

        -- every save (button, ConfigManager, auto save) refreshes the "updated" stamp
        local baseSave = Window.SaveConfig
        Window.SaveConfig = function(self, name)
            local ok, err = baseSave(self, name)
            if ok then
                touchStamp(self.ConfigName)
            end
            return ok, err
        end

        local function sanitizeName(raw)
            if type(raw) ~= "string" then
                return nil
            end
            local s = string.gsub(raw, "[^%w%-_ ]", "")
            s = string.match(s, "^%s*(.-)%s*$")
            if #s < 1 or #s > 32 then
                return nil
            end
            return s
        end

        local function relativeTime(ts)
            if type(ts) ~= "number" then
                return nil
            end
            local d = math.max(0, os.time() - ts)
            if d < 60 then
                return "just now"
            elseif d < 3600 then
                return math.floor(d / 60) .. "m ago"
            elseif d < 86400 then
                return math.floor(d / 3600) .. "h ago"
            elseif d < 2592000 then
                return math.floor(d / 86400) .. "d ago"
            end
            return math.floor(d / 2592000) .. "mo ago"
        end

        local function snapshotFlags()
            local data = {}
            for flag, element in pairs(Library.Flags) do
                if element._type and type(element.Get) == "function" then
                    local ok, entry = pcall(serializeFlag, element)
                    if ok then
                        data[flag] = entry
                    end
                end
            end
            return data
        end

        local function applyFlags(data)
            local previous = Window._autoSaveEnabled
            Window._autoSaveEnabled = false
            local applied = 0
            for flag, entry in pairs(data) do
                local element = Library.Flags[flag]
                if element and type(element.Set) == "function" and type(entry) == "table" and entry.Type == element._type then
                    if pcall(deserializeFlag, element, entry, false) then
                        applied += 1
                    end
                end
            end
            Window._autoSaveEnabled = previous
            return applied
        end

