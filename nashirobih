            if buyBusy then
                note("Busy, wait for the current action.", "Warning")
                return
            end
            if typeof(fireproximityprompt) ~= "function" then
                note("This executor has no fireproximityprompt", "Error")
                return
            end
            local char = LocalPlayer.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            if not hrp then
                return
            end

            buyBusy = true
            task.spawn(function()
                local oldCFrame = hrp.CFrame
                bypassTP(CFrame.new(-1589, 254, 17)) -- hospital, from WereBetter's teleport list
                task.wait(0.3)

                local best, bestDist = nil, math.huge
                for _, v in ipairs(UIsWorkspace:GetDescendants()) do
                    if v:IsA("ProximityPrompt") and v.Enabled then
                        local part = v.Parent:IsA("BasePart") and v.Parent
                            or (v.Parent:IsA("Attachment") and v.Parent.Parent)
                        if part and part:IsA("BasePart") then
                            local d = (part.Position - hrp.Position).Magnitude
                            if d < bestDist then
                                bestDist = d
                                best = v
                            end
                        end
                    end
                end

                if not best then
                    note("No prompt found at the hospital", "Error")
                    bypassTP(oldCFrame)
                    buyBusy = false
                    return
                end

                local target = best.Parent:IsA("Attachment") and best.Parent.Parent or best.Parent
                hrp.CFrame = target.CFrame
                task.wait(0.15)
                pcall(fireproximityprompt, best)
                note("Hospital prompt fired", "Success")
                buyBusy = false
            end)
        end,
    })
end

