    -- ── Execution ticker ──────────────────────────────────────────────────────
    local lastTick = os.clock()
    local tickConn
    tickConn = RunService.Heartbeat:Connect(function()
        if not execCell.Parent then tickConn:Disconnect() return end
        if os.clock() - lastTick < STAT_EXEC_TICK then return end
        lastTick = os.clock()
        executions = executions + 1
        if counting then return end

        -- Number rolls like an odometer
        execVal.Roll(fmtNum(executions))

        -- Zap icon: jolt + white flash, then settle
        execIco.ImageColor3 = C_WHITE
        tween(execIco, { Size = UDim2.fromOffset(22, 22), Rotation = -18, ImageColor3 = C_WHITE }, 0.1, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
