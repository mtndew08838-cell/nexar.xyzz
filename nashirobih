            Window._controlsDirty = true
            tween(overlay, { BackgroundTransparency = 0.45 }, 0.25)
            tween(dialogCard, { GroupTransparency = 0, Position = UDim2.fromScale(0.5, 0.5) }, 0.3, Enum.EasingStyle.Quint)
            tween(dialogScale, { Scale = 1 }, 0.4, Enum.EasingStyle.Back)
            task.defer(function()
                if not closed then
                    box:CaptureFocus()
                end
            end)
        end

        addSub("general", ConfigTab.Name, "sliders-horizontal", 0)

        -- ══ LOCAL CONFIGS ═════════════════════════════════════
        local localPage = addSub("local", "Local Configs", "hard-drive", 1)

        local saveRow = create("TextButton", {
            Size = UDim2.new(1, 0, 0, CARD_HEIGHT_DESC),
            BackgroundColor3 = Theme.Surface2,
            BorderSizePixel = 0,
            Text = "",
            AutoButtonColor = false,
            ClipsDescendants = true,
            Parent = localPage,
        })
        corner(saveRow)
        hoverStroke(saveRow, stroke(saveRow, Theme.Stroke))
        glowIcon(saveRow, "save", Theme.Accent, UDim2.new(0, 14, 0.5, 0))
        local saveTitle, saveDesc = titleDesc(saveRow, "Save Current Settings Locally", "Stays on this device only", 30)
        for _, l in ipairs({ saveTitle, saveDesc }) do
            l.Position = l.Position + UDim2.fromOffset(26, 0)
            l.Size = l.Size - UDim2.fromOffset(26, 0)
        end
        glowIcon(saveRow, BUTTON_HINT_ICON, Theme.Muted, UDim2.new(1, -30, 0.5, 0))

        local localPanelTop = CARD_HEIGHT_DESC + 10
        local localPanel = create("Frame", {
            Position = UDim2.fromOffset(0, localPanelTop),
            Size = UDim2.new(1, 0, 1, -localPanelTop),
            BackgroundColor3 = Theme.Surface,
            BackgroundTransparency = 0.35,
            BorderSizePixel = 0,
            Parent = localPage,
        })
        corner(localPanel, UDim.new(0, 10))
        stroke(localPanel, Theme.Stroke, 0.3)
        local localSearch = makeSearch(localPanel, "Search local configs...")
        local localGrid = makeGrid(localPanel)
        local localStatus = makeStatus(localPanel)

        local refreshLocal
        function refreshLocal(animate)
            clearCards(localGrid)
            local names = Window:ListConfigs()
            local entries = {}
            local query = string.lower(localSearch.Text)
            for _, name in ipairs(names) do
                if query == "" or string.find(string.lower(name), query, 1, true) then
                    table.insert(entries, { Name = name, Stamp = readStamp(name) })
                end
            end
            table.sort(entries, function(a, b)
                local sa, sb = a.Stamp or 0, b.Stamp or 0
                if sa ~= sb then
                    return sa > sb
                end
                return a.Name < b.Name
            end)
            for index, entry in ipairs(entries) do
                local when = relativeTime(entry.Stamp)
                makeCard(localGrid, index, entry.Name, when and ("updated " .. when) or "updated earlier", function()
                    local ok, err = Window:LoadConfig(entry.Name)
                    notify(ok and "Config loaded" or "Load failed", ok and entry.Name or tostring(err), ok and "Success" or "Error")
                end, function()
                    Window:Confirm({
                        Title = "Delete config",
                        Content = "Remove " .. entry.Name .. "? This cannot be undone.",
                        Icon = "trash-2",
                        ConfirmText = "Delete",
                        Callback = function()
                            local ok, err = Window:DeleteConfig(entry.Name)
                            if ok and fsReady() and type(delfile) == "function" then
                                pcall(function()
                                    if isfile(metaPath(entry.Name)) then
                                        delfile(metaPath(entry.Name))
                                    end
                                end)
                            end
                            refreshLocal()
                            notify(ok and "Config deleted" or "Delete failed", ok and entry.Name or tostring(err), ok and "Info" or "Error")
                        end,
                    })
                end)
            end
            localStatus.Visible = #entries == 0
            localStatus.Text = (#names == 0) and "No saved configs yet. Use \"Save Current Settings Locally\" above."
                or "No configs match your search."
            if animate then
                animateCards(localGrid)
            end
            Window._controlsDirty = true
        end
        local searchToken = 0
        localSearch:GetPropertyChangedSignal("Text"):Connect(function()
            searchToken += 1
            local mine = searchToken
            task.delay(0.12, function()
                if mine == searchToken then
                    refreshLocal(false)
                end
            end)
        end)
        onShow["local"] = function()
            refreshLocal(true)
        end

        saveRow.MouseButton1Click:Connect(function()
            ripple(saveRow)
            promptName(function(name)
                local ok, err = Window:SaveConfig(name)
                refreshLocal(true)
                notify(ok and "Config saved" or "Save failed", ok and name or tostring(err), ok and "Success" or "Error")
            end)
        end)

        -- ══ PUBLISH PUBLIC CONFIG ═════════════════════════════
        local publishPage = addSub("publish", "Publish Public Config", "cloud-upload", 2)
        local publishPanel = create("Frame", {
            Size = UDim2.fromScale(1, 1),
            BackgroundColor3 = Theme.Surface,
            BackgroundTransparency = 0.35,
            BorderSizePixel = 0,
            Parent = publishPage,
        })
        corner(publishPanel, UDim.new(0, 10))
        stroke(publishPanel, Theme.Stroke, 0.3)

        local function fieldLabel(text, y)
            label({
                Position = UDim2.fromOffset(14, y),
                Size = UDim2.new(1, -28, 0, 16),
                Text = text,
                TextSize = 13,
                TextColor3 = Theme.Muted,
                Parent = publishPanel,
            })
        end
        local function field(y, height, placeholder, multiline)
            local holder = create("Frame", {
                Position = UDim2.fromOffset(14, y),
                Size = UDim2.new(1, -28, 0, height),
                BackgroundColor3 = Theme.Surface2,
                BorderSizePixel = 0,
                Parent = publishPanel,
            })
            corner(holder, UDim.new(0, 8))
            local holderStroke = stroke(holder)
            local box = create("TextBox", {
                Position = UDim2.fromOffset(10, multiline and 8 or 0),
                Size = UDim2.new(1, -20, 1, multiline and -16 or 0),
                BackgroundTransparency = 1,
                Text = "",
                PlaceholderText = placeholder,
                PlaceholderColor3 = Theme.Muted,
                TextColor3 = Theme.Text,
                TextSize = 14,
                FontFace = Fonts.Regular,
                TextXAlignment = Enum.TextXAlignment.Left,
                TextYAlignment = multiline and Enum.TextYAlignment.Top or Enum.TextYAlignment.Center,
                MultiLine = multiline,
                TextWrapped = multiline,
                ClearTextOnFocus = false,
                TextTruncate = Enum.TextTruncate.None,
                ClipsDescendants = true,
                Parent = holder,
            })
            box.Focused:Connect(function()
                tween(holderStroke, { Color = Theme.StrokeHover }, 0.15)
            end)
            box.FocusLost:Connect(function()
                tween(holderStroke, { Color = Theme.Stroke }, 0.15)
            end)
            return box
        end
        fieldLabel("Config name", 14)
        local publishName = field(34, 36, "Name shown in Public Configs", false)
        fieldLabel("Description", 82)
        local publishDesc = field(102, 76, "What does this config do?", true)

        local publishButton = create("TextButton", {
            Position = UDim2.fromOffset(14, 192),
            Size = UDim2.fromOffset(0, 34),
            AutomaticSize = Enum.AutomaticSize.X,
            BackgroundColor3 = Theme.Accent,
            BackgroundTransparency = 0.12,
            BorderSizePixel = 0,
            Text = "",
            AutoButtonColor = false,
            Parent = publishPanel,
        })
        corner(publishButton, UDim.new(0, 7))
        stroke(publishButton, Theme.Accent, 0.4)
        padding(publishButton, 16, 16)
        local publishButtonText = label({
            Size = UDim2.new(0, 0, 1, 0),
            AutomaticSize = Enum.AutomaticSize.X,
            Text = "Publish Current Settings",
            TextSize = 13,
            TextColor3 = Theme.OnAccent,
            TextXAlignment = Enum.TextXAlignment.Center,
            Parent = publishButton,
        })
        local publishStatus = label({
            Position = UDim2.fromOffset(14, 236),
            Size = UDim2.new(1, -28, 0, 36),
            Text = "",
            TextSize = 13,
            FontFace = Fonts.Regular,
            TextColor3 = Theme.Muted,
            TextWrapped = true,
            TextTruncate = Enum.TextTruncate.None,
            TextYAlignment = Enum.TextYAlignment.Top,
            Parent = publishPanel,
        })

        local publishing = false
        onShow.publish = function()
            if backend() then
                publishButton.BackgroundTransparency = 0.12
                publishStatus.Text = ""
            else
                publishButton.BackgroundTransparency = 0.7
                publishStatus.TextColor3 = Theme.Warning
                publishStatus.Text = "Public backend not configured (Window.PublicConfigBackend). Publishing is disabled."
            end
        end
        publishButton.MouseButton1Click:Connect(function()
            local b = backend()
            if not b or type(b.publish) ~= "function" or publishing then
                onShow.publish()
                return
            end
            local name = sanitizeName(publishName.Text)
            if not name then
                publishStatus.TextColor3 = Theme.Error
                publishStatus.Text = "Name must be 1-32 characters (letters, numbers, space, - _)"
                return
            end
            publishing = true
            publishButtonText.Text = "Publishing..."
            publishStatus.TextColor3 = Theme.Muted
            publishStatus.Text = ""
            local flags = snapshotFlags()
            task.spawn(function()
                local okCall, ok, err = pcall(b.publish, name, publishDesc.Text, flags)
                publishing = false
                publishButtonText.Text = "Publish Current Settings"
                if okCall and ok == true then
                    publishStatus.Text = ""
                    notify("Config published", name, "Success")
                else
                    publishStatus.TextColor3 = Theme.Error
                    publishStatus.Text = "Publish failed: " .. tostring(okCall and err or ok)
                end
            end)
        end)

        -- ══ PUBLIC CONFIGS ════════════════════════════════════
        local publicPage = addSub("public", "Public Configs", "cloud", 3)
        local publicPanel = create("Frame", {
            Size = UDim2.fromScale(1, 1),
            BackgroundColor3 = Theme.Surface,
            BackgroundTransparency = 0.35,
            BorderSizePixel = 0,
            Parent = publicPage,
        })
        corner(publicPanel, UDim.new(0, 10))
        stroke(publicPanel, Theme.Stroke, 0.3)
        local publicSearch = makeSearch(publicPanel, "Search public configs...")
        local publicGrid = makeGrid(publicPanel)
        local publicStatus = makeStatus(publicPanel)

        local publicToken = 0
        local function refreshPublic()
            publicToken += 1
            local mine = publicToken
            clearCards(publicGrid)
            publicStatus.Visible = true
            local b = backend()
            if not b or type(b.list) ~= "function" then
                publicStatus.Text = "Public backend not configured (Window.PublicConfigBackend)."
                return
            end
            publicStatus.Text = "Loading..."
            task.spawn(function()
                local ok, result = pcall(b.list, publicSearch.Text)
                if mine ~= publicToken then
                    return
                end
                if not ok or type(result) ~= "table" then
                    publicStatus.Text = "Could not load public configs."
                    return
                end
                local shown = 0
                for index, entry in ipairs(result) do
                    if type(entry) == "table" and type(entry.name) == "string" then
                        shown += 1
                        local parts = {}
                        if entry.author then
                            table.insert(parts, "by " .. tostring(entry.author))
                        end
                        local when = relativeTime(entry.updatedAt)
                        if when then
                            table.insert(parts, "updated " .. when)
                        end
                        makeCard(publicGrid, index, entry.name, table.concat(parts, " · "), function()
                            task.spawn(function()
                                local okD, data = pcall(b.download, entry)
                                if not okD or type(data) ~= "table" then
                                    notify("Download failed", entry.name, "Error")
                                    return
                                end
                                local applied = applyFlags(data)
                                notify("Config loaded", entry.name .. " (" .. applied .. " settings)", "Success")
                            end)
                        end, nil)
                    end
                end
                animateCards(publicGrid)
                publicStatus.Visible = shown == 0
                publicStatus.Text = "No public configs found."
                Window._controlsDirty = true
            end)
        end
        publicSearch.FocusLost:Connect(function()
            refreshPublic()
        end)
        onShow.public = refreshPublic

        -- refresh whenever the Config page is brought to the front
        page:GetPropertyChangedSignal("Parent"):Connect(function()
            if page.Parent == Window._inLayer then
                local key = currentSub
                currentSub = nil
                selectSub(key or "general")
                task.delay(0.05, moveIndicator, currentSub, true)
            end
        end)

        selectSub("general")
    end)
    if not okConfig then
        warn("[Config tab] failed to build: " .. tostring(errConfig))
    end
end

Window:LoadConfig()

Window:FinishLoading()
