            if execIco.Parent then
                tween(execIco, { Size = UDim2.fromOffset(14, 14), Rotation = 0, ImageColor3 = C_ORANGE }, 0.6, Enum.EasingStyle.Elastic, Enum.EasingDirection.Out)
