        opts.LoadingTitle = loading.Title or opts.LoadingTitle
        opts.LoadingWaitForFinish = loading.WaitForFinish
        loading = loading.Enabled ~= false
    end
    if loading ~= false then
        self:_showLoader(opts)
    end

    self:_buildSearch()

    if opts.Home then
        self:_buildHome(type(opts.Home) == "table" and opts.Home or {})
    end

    self._built = true
    if loading == false then
        task.defer(function()
            self:_playIntro()
        end)
    end
    return self
end

